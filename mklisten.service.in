[Unit]
Description=MK BBS listener (mklisten starts one mk per caller)
Documentation=file:@SYSCONFDIR@/mklisten.example.json
After=network.target

[Service]
Type=notify
NotifyAccess=main
# systemd restarts the listener when it stops sending its heartbeat for this long (mklisten sends one every third of it)
WatchdogSec=60
User=@MKUSER@
Group=@MKUSER@
ExecStart=@BINDIR@/mklisten -f -c @SYSCONFDIR@/mklisten.json
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5

# /run/mkbbs holds the node files (set "rundir": "/run/mkbbs" in mklisten.json,
# the installed file has it) and /var/log/mkbbs the log file; both belong to the user.
RuntimeDirectory=mkbbs
LogsDirectory=mkbbs

# Stopping or restarting the listener must not hang up the callers: they are
# processes of their own (mk) and carry on until they log off.  (The mailer, mkbink,
# is stopped by the listener itself.)  systemctl reload makes the mailer read its
# settings again.
KillMode=process
SendSIGKILL=no

# Ports below 1024 without being root
AmbientCapabilities=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
