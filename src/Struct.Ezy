  BankKBytes: Word;
  FilePoints: Word;
  Packer: Byte;
  LastQwk: Byte;
  Comment: String[40];
  Colors: Array[1..4] of Byte;
  Background: Byte;
  SessionFailures: Byte;
  TopMenu: String[8];
  NewPoints: Word;
  BirthYear: Word;
  BirthMonth: Byte;
  BirthDay: Byte;
  Groups: LongInt;
  RegDate: Word;
  FirstDate: Word;
  NewDate: Word;
  Protocol: Char;
  TimeRemain: Word;
  CurrFileArea: Word;
  CurrMsgArea: Word;
  MaxQwkMsgs: Word;
  MaxPerArea: Word;
