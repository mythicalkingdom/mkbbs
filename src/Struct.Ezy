
{       ********** Ezy Structures ************        }

Const
  MaxMsgAreas = 1024;


Type ConstType = Record                {Constant.Ezy in BBS dir}
  Vers: String[8];
  SystemName: String[40];
  SysopName: String[35];
  SysopHdl: String[35];
  BBSLocation: String[35];
  MultiLine: Boolean;
  UsableMsg: Word;
  UsableFile: Word;
  WatchArea: Word;
  PageMsgArea: Word;
  PwdMsgArea: Word;
  MinTime: Byte;
  Extra1: Array[1..11] of Byte;
  Attr1: Word;
  Attr2: Word;
  MaxRescan: Word;
  BoardId: String[8];
  OfflineMax: Word;
  BadOffline: Word;
  Addr: Array[1..16] of AddrType;
  NetBoard: Array[1..16] of Word;
  NewGroup: Array[1..16] of Char;
  NewStart: Array[1..16] of Word;
  QuoteStr: String[5];
  MailSwap: Boolean;
  UnknownArea: Byte;
  FeditSwap: Byte;
  ViewSwap: Byte;
  MinULSpace: Word;
  InputColor: Byte;
  BadMsgArea: Word;
  Extra2: Array[1..89] of Byte;
  End;


Type UsersType = Record                {Users.Bbs file in userbase path}
  Name: String[35];                    {Users Name - Proper Case}
  Handle: String[35];
  Pwd: String[15];
  Security: Word;
  Attr: Byte;
  Attr2: Byte;
  Attr3: Byte;
  Attr4: Byte;
  Flags: LongInt;
  DPhone: String[14];                  {Users Date/Business Phone}
  HPhone: String[14];                  {Home/Voice Phone}
  End;


Const                                  {Users.Attr values}
  uaDeleted =      1;                  {User is deleted}
  uaScrnClr =      2;                  {Clear screen between displays}
  uaMore =         4;                  {Ask more?}
  uaAnsi =         8;                  {Wants ansi screens}
  uaNoKill =      16;                  {Do not purge ever}
  uaIgnorePts =   32;                  {Ignore DL hours}
  uaFullScrEd =   64;                  {Use full screen editor}
  uaQuiet =      128;

  ua2NoRatio =     1;
  ua2IBMChars =    2;
  ua2USDate =      4;
  ua2IgnoreHrs =   8;
  ua2Exclude =    16;
  ua2Avatar  =    32;
  ua2IgnoreTime = 64;
  ua2IgnoreMsg = 128;

  ua3Silent =      1;
  ua3AutoPage =    2;
  ua3Hold =        4;
  ua3Combined =    8;


