Type MsgAreaType = Record              {Messages.Ezy in the system dir}
  Name: String[30];                    {Name of message area}
  AreaTag: String[30];
  ShortName: String[12];               {Short name of msg area}
  Typ: Byte;
  MsgKinds: Byte;
  Attr: Byte;
  Attr2: Byte;
  Attr3: Byte;
  DaysKept: Byte;
  RcvdDays: Byte;
  MsgsKept: Word;
  KKept: Word;
  ReadSec: Word;
  ReadFlags: LongInt;
  WriteSec: Word;
  WriteFlags: LongInt;
  SysopSec: Word;
  SysopFlags: LongInt;
  Origin: String[50];
  Addr: Byte;                          {Which address to use}
  SeenBy: Word;
  AreaGroup: Char;
  MsgGroup: Char;
{  DestNodes: Array[1..3] of Byte;}
  DestNodes: Array[1.. (128 Div 8)] of Byte;
  EchoFeed: Byte;
  End;



Type FileAreaType = Record             {Files.MK file}
  Name: String[30];                    {Name - blank = unused}
  Attr: Byte;
  Convert: Byte;
  FileGroup: Char;
  UpTmplt: Word;
  ULPath: Word;
  FreeSpace: LongInt;
  SecLevel: Word;
  SecFlags: LongInt;
  SysopLevel: Word;
  SysopFlags: LongInt;
  End;


