{$V-}

Unit CFGSEC2;

{$I OPDEFINE.INC}

Interface

Uses CfgGlob, MKGlobT, OpEntry;

Procedure EnterSec(Var Sec: SecType; Title: String);
Procedure GetSecurity(Var Sec: SecType; Var ESP: EntryScreenPtr;
  ScreenNo: Word; Title: String);

Implementation


uses
  Dos,  OpInline,  OpString,  OpRoot,  OpCrt,  OpColor,  OpMouse,
  OpAbsFld,  OpCmd,  OpField,  OpFrame,  OpWindow,  OpSelect;


{Entry field constants}
const
  idLevel                = 0;
  idFlag1                = idLevel + 1;
  idFlag2                = idFlag1 + 1;
  idFlag3                = idFlag2 + 1;
  idFlag4                = idFlag3 + 1;

{Help index constants}
const
  hiLevel                = 1;
  hiFlag1                = hiLevel + 1;
  hiFlag2                = hiFlag1 + 1;
  hiFlag3                = hiFlag2 + 1;
  hiFlag4                = hiFlag3 + 1;


Type  ByteArray = Array[1..4] of Byte;


Var
  ES     : EntryScreen;
  UR     : SecType;
  Flag1: String[8];
  Flag2: String[8];
  Flag3: String[8];
  Flag4: String[8];
  Status : Word;



Procedure GetSecurity(Var Sec: SecType; Var ESP: EntryScreenPtr;
  ScreenNo: Word; Title: String);

  Var
    Temp: Word;

  Const
    Wait = 100;

  Begin
  Delay(Wait);
  ESP^.PositionCursorAt(ESP^.FindField(ScreenNo));
  HideMouse;
  Temp := ReadKeyWord;
    Case Temp of
    7181: Begin
          EnterSec(Sec, Title);
          ESP^.DrawField(ScreenNo);
          ESP^.SetNextField(ScreenNo + 1);
          End;
    Else
      StuffKey(Temp);
    End;
  ShowMouse;
  End;




{$F+}
procedure PreEdit(ESP : EntryScreenPtr);
  {-Called just before a field is edited}
begin
  with ESP^ do
    case GetCurrentID of
      idLevel                : ;
      idFlag1                : ;
      idFlag2                : ;
      idFlag3                : ;
      idFlag4                : ;
    end;
end;

procedure PostEdit(ESP : EntryScreenPtr);
  {-Called just after a field has been edited}
begin
  with ESP^ do
    case GetCurrentID of
      idLevel                : ;
      idFlag1                : ;
      idFlag2                : ;
      idFlag3                : ;
      idFlag4                : ;
    end;
end;

procedure IncChoice(var Value; ID : Word; Factor : Integer; var St : string);
  {-Increment a multiple choice field value and convert it to a string}
begin
end;

procedure ErrorHandler(UnitCode : Byte; var ErrCode : Word; Msg : string);
  {-Report errors}
begin
  RingBell;
end;

procedure DisplayHelp(UnitCode : Byte; IdPtr : Pointer; HelpIndex : Word);
  {-Display context sensitive help}
begin
end;
{$F-}

function InitEntryScreen(Title: String): Word;
  {-Initialize entry screen generated by MAKESCRN}
const
  WinOptions = wBordered+wClear+wUserContents;
begin
  with ES do begin
    if not InitCustom(24, 6, 45, 16, EsColors, WinOptions) then begin
      InitEntryScreen := InitStatus;
      Exit;
    end;
    UserSet1 := ['-','X','x'];

    wFrame.SetFrameType(Frame1);
    wFrame.AddShadow(shBR, shSeeThru);
    wFrame.AddHeader(Title, heTC);
    SetWrapMode(ExitAtEdges);
    EnableExplosions(10);
    SetPreEditProc(PreEdit);
    SetPostEditProc(PostEdit);
    SetErrorProc(ErrorHandler);
    EntryCommands.SetHelpProc(DisplayHelp);

  {idLevel:}
    AddWordField(
      'Level:', 2, 3,
      '99999', 2, 10,
      hiLevel, 0, 65535, UR.Level);


    esFieldOptionsOn(efForceOverType + efForceMode);
    esFieldOptionsOn(efForceUpper);

  {idFlag1:}
    AddStringField(
      'A Flags:', 4, 3,
      '11111111', 4, 12, 8,
      hiFlag1, Flag1);

  {idFlag2:}
    AddStringField(
      'B Flags:', 6, 3,
      '11111111', 6, 12, 8,
      hiFlag2, Flag2);

  {idFlag3:}
    AddStringField(
      'C Flags:', 8, 3,
      '11111111', 8, 12, 8,
      hiFlag3, Flag3);

  {idFlag4:}
    AddStringField(
      'D Flags:', 10, 3,
      '11111111', 10, 12, 8,
      hiFlag4, Flag4);


    esFieldOptionsOff(efForceOverType + efForceMode);

    InitEntryScreen := RawError;
  end;
end;


Procedure EnterSec(Var Sec: SecType; Title: String);
  Begin
  UR := Sec;
  Flag1 := Flag2Str(ByteArray(UR.Flags)[1]);
  Flag2 := Flag2Str(ByteArray(UR.Flags)[2]);
  Flag3 := Flag2Str(ByteArray(UR.Flags)[3]);
  Flag4 := Flag2Str(ByteArray(UR.Flags)[4]);
  if MouseInstalled then
    with EsColors do begin
      {activate mouse cursor}
      SoftMouseCursor($0000, (ColorMono(MouseColor, MouseMono) shl 8)+
                             Byte(MouseChar));
      ShowMouse;
      {enable mouse support}
      EntryCommands.cpOptionsOn(cpEnableMouse);
    end;
  Status := InitEntryScreen(Title);
  if Status <> 0 then begin
    WriteLn('Error initializing entry screen: ', Status);
    Halt(1);
  end;
  ES.Process;
  ES.Erase;
  HideMouse;
  ES.Done;
  Sec := UR;
  ByteArray(Sec.Flags)[1] := Str2Flag(Flag1);
  ByteArray(Sec.Flags)[2] := Str2Flag(Flag2);
  ByteArray(Sec.Flags)[3] := Str2Flag(Flag3);
  ByteArray(Sec.Flags)[4] := Str2Flag(Flag4);
  End;


End.
