{$V-}

Unit CFGSEC;


{$I OPDEFINE.INC}


Interface


Procedure DoCfgSec;


Implementation


uses
  Dos,  OpInline,  OpString,  OpRoot,  OpCrt,  OpColor,  OpMouse,
  OpAbsFld,  OpCmd,  OpField,  OpFrame,  OpWindow,  OpSelect,
  OpEntry, CfgGlob, MKGlobT, MKCfgAbs;

const
  idPassTries            = 0;
  idPwdExpire            = idPassTries + 1;
  idCheckBD              = idPwdExpire + 1;
  idCheckPhone           = idCheckBD + 1;
  idMinPWD               = idCheckPhone + 1;
  idMinPhone             = idMinPWD + 1;
  idStrictPWD            = idMinPhone + 1;
  idSysopRemote          = idStrictPWD + 1;
  idFastLogIn            = idSysopRemote + 1;

const
  hiPassTries            = 1;
  hiPwdExpire            = hiPassTries + 1;
  hiCheckBD              = hiPwdExpire + 1;
  hiCheckPhone           = hiCheckBD + 1;
  hiMinPWD               = hiCheckPhone + 1;
  hiMinPhone             = hiMinPWD + 1;
  hiStrictPWD            = hiMinPhone + 1;
  hiSysopRemote          = hiStrictPWD + 1;
  hiFastLogIn            = hiSysopRemote + 1;


Type UserRecord = Record
  PassTries: Byte;
  PwdExpire: Word;
  CheckBD: Byte;
  CheckPhone: Byte;
  MinPwd: Byte;
  MinPhone: Byte;
  StrictPwd: Boolean;
  SysopRemote: Boolean;
  FastLogIn: Boolean;
  End;


Var
  ES     : EntryScreen;
  Status : Word;
  UR: ^UserRecord;


{$F+}
procedure PreEdit(ESP : EntryScreenPtr);
  {-Called just before a field is edited}
begin
  with ESP^ do
    case GetCurrentID of
      idPassTries            : ;
      idPwdExpire            : ;
      idCheckBD              : ;
      idCheckPhone           : ;
      idMinPWD               : ;
      idMinPhone             : ;
      idStrictPWD            : ;
      idSysopRemote          : ;
      idFastLogIn            : ;
    end;
end;

procedure PostEdit(ESP : EntryScreenPtr);
  {-Called just after a field has been edited}
begin
  with ESP^ do
    case GetCurrentID of
      idPassTries            : ;
      idPwdExpire            : ;
      idCheckBD              : ;
      idCheckPhone           : ;
      idMinPWD               : ;
      idMinPhone             : ;
      idStrictPWD            : ;
      idSysopRemote          : ;
      idFastLogIn            : ;
    end;
end;

procedure IncChoice(var Value; ID : Word; Factor : Integer; var St : string);
  {-Increment a multiple choice field value and convert it to a string}
begin
end;

procedure ErrorHandler(UnitCode : Byte; var ErrCode : Word; Msg : string);
  {-Report errors}
begin
  RingBell;
end;

procedure DisplayHelp(UnitCode : Byte; IdPtr : Pointer; HelpIndex : Word);
  {-Display context sensitive help}
begin
end;
{$F-}

function InitEntryScreen : Word;
  {-Initialize entry screen generated by MAKESCRN}
const
  WinOptions = wBordered+wClear+wUserContents;
begin
  with ES do begin
    if not InitCustom(9, 6, 71, 16, EsColors, WinOptions) then begin
      InitEntryScreen := InitStatus;
      Exit;
    end;

    wFrame.SetFrameType(Frame1);
    wFrame.AddShadow(shBR, shSeeThru);
    wFrame.AddHeader('[ Security ]', heTC);
    esFieldOptionsOn(efCursorToEnd+efClearFirstChar);
    SetWrapMode(WrapAtEdges);

    SetPreEditProc(PreEdit);
    SetPostEditProc(PostEdit);
    SetErrorProc(ErrorHandler);
    EntryCommands.SetHelpProc(DisplayHelp);

  {idPassTries:}
    AddByteField(
      'Password Tries:', 2, 3,
      '999', 2, 19,
      hiPassTries, 0, 255, UR^.PassTries);

  {idPwdExpire:}
    AddWordField(
      'Password Expiration:', 2, 33,
      '999', 2, 54,
      hiPwdExpire, 0, 999, UR^.PwdExpire);

  {idCheckBD:}
    AddByteField(
      'Birthday Check:', 4, 3,
      '999', 4, 19,
      hiCheckBD, 0, 255, UR^.CheckBD);

  {idCheckPhone:}
    AddByteField(
      'Phone Check:', 4, 33,
      '999', 4, 46,
      hiCheckPhone, 0, 255, UR^.CheckPhone);

  {idMinPWD:}
    AddByteField(
      'Minimum Password Length:', 6, 3,
      '99', 6, 28,
      hiMinPWD, 1, 30, UR^.MinPWD);

  {idMinPhone:}
    AddByteField(
      'Minimum Phone # Length:', 6, 33,
      '99', 6, 57,
      hiMinPhone, 1, 15, UR^.MinPhone);

  {idStrictPWD:}
    esFieldOptionsOn(efClickExit);
    AddYesNoField(
      'Strict Password Checking:', 8, 3,
      'Y', 8, 29,
      hiStrictPWD, UR^.StrictPWD);
    esFieldOptionsOff(efClickExit);

  {idSysopRemote:}
    esFieldOptionsOn(efClickExit);
    AddYesNoField(
      'Allow Remote Sysop:', 8, 33,
      'Y', 8, 53,
      hiSysopRemote, UR^.SysopRemote);
    esFieldOptionsOff(efClickExit);

  {idFastLogIn:}
    esFieldOptionsOn(efClickExit);
    AddYesNoField(
      'Fast Local Log-in:', 10, 3,
      'Y', 10, 22,
      hiFastLogIn, UR^.FastLogIn);
    esFieldOptionsOff(efClickExit);

    InitEntryScreen := RawError;
  end;
end;


Procedure DoCfgSec;
  begin
  New(UR);
  UR^.PassTries := Config^.GetPwdTries;
  UR^.PwdExpire := Config^.GetPwdExpire;
  UR^.CheckBD := Config^.GetBDCheck;
  UR^.CheckPhone := Config^.GetPhoneCheck;
  UR^.MinPwd := Config^.GetMinPwd;
  UR^.MinPhone := Config^.GetMinPhone;
  UR^.StrictPwd := Config^.GetStrictPwd;
  UR^.SysopRemote := Config^.GetRemoteSysop;
  UR^.FastLogIn := Config^.GetFastLocal;
  If MouseInstalled Then
    With EsColors do
      Begin
      {activate mouse cursor}
      SoftMouseCursor($0000, (ColorMono(MouseColor, MouseMono) shl 8)+
                             Byte(MouseChar));
      ShowMouse;
      {enable mouse support}
      EntryCommands.cpOptionsOn(cpEnableMouse);
    end;
  Status := InitEntryScreen;
  if Status <> 0 then
    Begin
    WriteLn('Error initializing entry screen: ', Status);
    Halt(1);
    End;
  ES.Process;
  ES.Erase;
  HideMouse;
  ES.Done;
  Config^.SetPwdTries(UR^.PassTries);
  Config^.SetPwdExpire(UR^.PwdExpire);
  Config^.SetBDCheck(UR^.CheckBD);
  Config^.SetPhoneCheck(UR^.CheckPhone);
  Config^.SetMinPwd(UR^.MinPwd);
  Config^.SetMinPhone(UR^.MinPhone);
  Config^.SetStrictPwd(UR^.StrictPwd);
  Config^.SetRemoteSysop(UR^.SysopRemote);
  Config^.SetFastLocal(UR^.FastLogIn);
  Dispose(UR);
  End;


End.
