{$V-}

Unit CFGEL;

{$I OPDEFINE.INC}

Interface


Procedure DoCfgEL;


Implementation


Uses
  Dos,  OpInline,  OpString,  OpRoot,  OpCrt,  OpColor,
  OpMouse,  OpAbsFld,  OpCmd,  OpField,  OpFrame,  OpWindow,
  OpSelect,  OpEntry, CfgGlob, MKGlobT, MKCfgAbs;

const
  MouseChar  : Char = #04;

{Entry field constants}
const
  idLocEL                = 0;
  idb300                 = idLocEL + 1;
  idb1200                = idb300 + 1;
  idb2400                = idb1200 + 1;
  idb4800                = idb2400 + 1;
  idb7200                = idb4800 + 1;
  idb9600                = idb7200 + 1;
  idb12000               = idb9600 + 1;
  idb14400               = idb12000 + 1;
  idb19200               = idb14400 + 1;
  idb38400               = idb19200 + 1;

{Help index constants}
const
  hiLocEL                = 1;
  hib300                 = hiLocEL + 1;
  hib1200                = hib300 + 1;
  hib2400                = hib1200 + 1;
  hib4800                = hib2400 + 1;
  hib7200                = hib4800 + 1;
  hib9600                = hib7200 + 1;
  hib12000               = hib9600 + 1;
  hib14400               = hib12000 + 1;
  hib19200               = hib14400 + 1;
  hib38400               = hib19200 + 1;

type
  UserRecord =
    record
      LocEL                : Byte;
      b300                 : Byte;
      b1200                : Byte;
      b2400                : Byte;
      b4800                : Byte;
      b7200                : Byte;
      b9600                : Byte;
      b12000               : Byte;
      b14400               : Byte;
      b19200               : Byte;
      b38400               : Byte;
    end;
var
  ES: EntryScreen;
  UR: ^UserRecord;
  Status: Word;

{$F+}
procedure PreEdit(ESP : EntryScreenPtr);
  {-Called just before a field is edited}
begin
  with ESP^ do
    case GetCurrentID of
      idLocEL                : ;
      idb300                 : ;
      idb1200                : ;
      idb2400                : ;
      idb4800                : ;
      idb7200                : ;
      idb9600                : ;
      idb12000               : ;
      idb14400               : ;
      idb19200               : ;
      idb38400               : ;
    end;
end;

procedure PostEdit(ESP : EntryScreenPtr);
  {-Called just after a field has been edited}
begin
  with ESP^ do
    case GetCurrentID of
      idLocEL                : ;
      idb300                 : ;
      idb1200                : ;
      idb2400                : ;
      idb4800                : ;
      idb7200                : ;
      idb9600                : ;
      idb12000               : ;
      idb14400               : ;
      idb19200               : ;
      idb38400               : ;
    end;
end;

procedure IncChoice(var Value; ID : Word; Factor : Integer; var St : string);
  {-Increment a multiple choice field value and convert it to a string}
begin
end;

procedure ErrorHandler(UnitCode : Byte; var ErrCode : Word; Msg : string);
  {-Report errors}
begin
  RingBell;
end;

procedure DisplayHelp(UnitCode : Byte; IdPtr : Pointer; HelpIndex : Word);
  {-Display context sensitive help}
begin
end;
{$F-}

function InitEntryScreen : Word;
  {-Initialize entry screen generated by MAKESCRN}
const
  WinOptions = wBordered+wClear+wUserContents;
begin
  with ES do begin
    if not InitCustom(22, 8, 45, 20, EsColors, WinOptions) then begin
      InitEntryScreen := InitStatus;
      Exit;
    end;

    wFrame.SetFrameType(Frame1);
    wFrame.AddShadow(shBR, shSeeThru);
    wFrame.AddHeader('[ ErrorLevels ]', heTC);
    esFieldOptionsOn(efCursorToEnd+efClearFirstChar);
    SetWrapMode(WrapAtEdges);

    SetPreEditProc(PreEdit);
    SetPostEditProc(PostEdit);
    SetErrorProc(ErrorHandler);
    EntryCommands.SetHelpProc(DisplayHelp);

  {idLocEL:}
    AddByteField(
      'Local:', 2, 7,
      '999', 2, 14,
      hiLocEL, 0, 255, UR^.LocEL);

  {idb300:}
    AddByteField(
      '  300:', 3, 7,
      '999', 3, 14,
      hib300, 0, 255, UR^.b300);

  {idb1200:}
    AddByteField(
      ' 1200:', 4, 7,
      '999', 4, 14,
      hib1200, 0, 255, UR^.b1200);

  {idb2400:}
    AddByteField(
      ' 2400:', 5, 7,
      '999', 5, 14,
      hib2400, 0, 255, UR^.b2400);

  {idb4800:}
    AddByteField(
      ' 4800:', 6, 7,
      '999', 6, 14,
      hib4800, 0, 255, UR^.b4800);

  {idb7200:}
    AddByteField(
      ' 7200:', 7, 7,
      '999', 7, 14,
      hib7200, 0, 255, UR^.b7200);

  {idb9600:}
    AddByteField(
      ' 9600:', 8, 7,
      '999', 8, 14,
      hib9600, 0, 255, UR^.b9600);

  {idb12000:}
    AddByteField(
      '12000:', 9, 7,
      '999', 9, 14,
      hib12000, 0, 255, UR^.b12000);

  {idb14400:}
    AddByteField(
      '14400:', 10, 7,
      '999', 10, 14,
      hib14400, 0, 255, UR^.b14400);

  {idb19200:}
    AddByteField(
      '19200:', 11, 7,
      '999', 11, 14,
      hib19200, 0, 255, UR^.b19200);

  {idb38400:}
    AddByteField(
      '38400:', 12, 7,
      '999', 12, 14,
      hib38400, 0, 255, UR^.b38400);

    InitEntryScreen := RawError;
    end;
  end;


Procedure DoCfgEL;
  Begin
  New(UR);
  UR^.LocEL := Config^.GetErrorLevel(1);
  UR^.B300 := Config^.GetErrorLevel(2);
  UR^.B1200 := Config^.GetErrorLevel(3);
  UR^.B2400 := Config^.GetErrorLevel(4);
  UR^.B4800 := Config^.GetErrorLevel(5);
  UR^.B7200 := Config^.GetErrorLevel(6);
  UR^.B9600 := Config^.GetErrorLevel(7);
  UR^.B12000 := Config^.GetErrorLevel(8);
  UR^.B14400 := Config^.GetErrorLevel(9);
  UR^.B19200 := Config^.GetErrorLevel(10);
  UR^.B38400 := Config^.GetErrorLevel(11);
  if MouseInstalled then
    with EsColors do begin
      {activate mouse cursor}
      SoftMouseCursor($0000, (ColorMono(MouseColor, MouseMono) shl 8)+
                             Byte(MouseChar));
      ShowMouse;
      {enable mouse support}
      EntryCommands.cpOptionsOn(cpEnableMouse);
    end;
  Status := InitEntryScreen;
  if Status <> 0 then begin
    WriteLn('Error initializing entry screen: ', Status);
    Halt(1);
  end;
  ES.Process;
  ES.Erase;
  HideMouse;
  ES.Done;
  Config^.SetErrorLevel(1, UR^.LocEL);
  Config^.SetErrorLevel(2, UR^.B300);
  Config^.SetErrorLevel(3, UR^.B1200);
  Config^.SetErrorLevel(4, UR^.B2400);
  Config^.SetErrorLevel(5, UR^.B4800);
  Config^.SetErrorLevel(6, UR^.B7200);
  Config^.SetErrorLevel(7, UR^.B9600);
  Config^.SetErrorLevel(8, UR^.B12000);
  Config^.SetErrorLevel(9, UR^.B14400);
  Config^.SetErrorLevel(10, UR^.B19200);
  Config^.SetErrorLevel(11, UR^.B38400);
  Dispose(UR);
  End;


End.
