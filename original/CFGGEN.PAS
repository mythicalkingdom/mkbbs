{$V-}

Unit CFGGEN;

Interface

Procedure DoCfgGen;

Implementation

Uses
  Dos,  OpInline,  OpString,  OpRoot,  OpCrt,  OpColor,
  OpMouse,  OpAbsFld,  OpCmd,  OpField,  OpFrame,  OpWindow,
  OpSelect,  OpEntry, CfgGlob, MKGlobT, MKColor, MKCfgAbs;

{Entry field constants}
const
  idSystemName           = 0;
  idBbsLocation          = idSystemName + 1;
  idBbsPhone             = idBbsLocation + 1;
  idBoardId              = idBbsPhone + 1;
  idSysopName            = idBoardId + 1;
  idColor1               = idSysopName + 1;
  idColor2               = idColor1 + 1;
  idColor3               = idColor2 + 1;
  idColor4               = idColor3 + 1;
  idColor5               = idColor4 + 1;
  idDirectWrite          = idColor5 + 1;
  idSnowCheck            = idDirectWrite + 1;
  idMonoMode             = idSnowCheck + 1;
  idPrnName = idMonoMode + 1;

{Help index constants}
const
  hiSystemName           = 1;
  hiBbsLocation          = hiSystemName + 1;
  hiBbsPhone             = hiBbsLocation + 1;
  hiBoardId              = hiBbsPhone + 1;
  hiSysopName            = hiBoardId + 1;
  hiColor1               = hiSysopName + 1;
  hiColor2               = hiColor1 + 1;
  hiColor3               = hiColor2 + 1;
  hiColor4               = hiColor3 + 1;
  hiColor5               = hiColor4 + 1;
  hiDirectWrite          = hiColor5 + 1;
  hiSnowCheck            = hiDirectWrite + 1;
  hiMonoMode             = hiSnowCheck + 1;
  hiPrnName = hiMonoMode + 1;


Type UserRecord = Record
  SystemName: String[40];
  BbsLocation: String[40];
  BbsPhone: String[15];
  SysopName: String[35];
  BoardId: String[8];
  Color: Array[1..5] of Byte;
  DirectWrite: Boolean;
  SnowCheck: Boolean;
  MonoMode: Boolean;
  PrnName: String[20];
  End;

var
  ES     : EntryScreen;
  Status : Word;
  UR: ^UserRecord;
  i: Word;

{$F+}
procedure PreEdit(ESP : EntryScreenPtr);
  {-Called just before a field is edited}
begin
  with ESP^ do
    case GetCurrentID of
      idSystemName           : ;
      idBbsLocation          : ;
      idBbsPhone             : ;
      idBoardId              : ;
      idSysopName            : ;
      idColor1: GetColor(UR^.Color[1], ESP, idColor1, '[ Select Color 1 ]');
      idColor2: GetColor(UR^.Color[2], ESP, idColor2, '[ Select Color 2 ]');
      idColor3: GetColor(UR^.Color[3], ESP, idColor3, '[ Select Color 3 ]');
      idColor4: GetColor(UR^.Color[4], ESP, idColor4, '[ Select Color 4 ]');
      idColor5: GetColor(UR^.Color[5], ESP, idColor5, '[ Select Color 5 ]');
      idDirectWrite          : ;
      idSnowCheck            : ;
      idMonoMode             : ;
    end;
end;

procedure PostEdit(ESP : EntryScreenPtr);
  {-Called just after a field has been edited}
begin
  with ESP^ do
    case GetCurrentID of
      idSystemName           : ;
      idBbsLocation          : ;
      idBbsPhone             : ;
      idBoardId              : ;
      idSysopName            : ;
      idColor1               : ;
      idColor2               : ;
      idColor3               : ;
      idColor4               : ;
      idDirectWrite          : ;
      idSnowCheck            : ;
      idMonoMode             : ;
    end;
end;

procedure IncChoice(var Value; ID : Word; Factor : Integer; var St : string);
  {-Increment a multiple choice field value and convert it to a string}
begin
end;

procedure ErrorHandler(UnitCode : Byte; var ErrCode : Word; Msg : string);
  {-Report errors}
begin
  RingBell;
end;

procedure DisplayHelp(UnitCode : Byte; IdPtr : Pointer; HelpIndex : Word);
  {-Display context sensitive help}
begin
end;
{$F-}

function InitEntryScreen : Word;
  {-Initialize entry screen generated by MAKESCRN}
const
  WinOptions = wBordered+wClear+wUserContents;
begin
  with ES do begin
    if not InitCustom(3, 6, 73, 20, EsColors, WinOptions) then begin
      InitEntryScreen := InitStatus;
      Exit;
    end;

    wFrame.SetFrameType(Frame1);
    wFrame.AddHeader('[ General System Info ]', heTC);
    wFrame.AddShadow(shBR, shSeeThru);
    esFieldOptionsOn(efCursorToEnd+efClearFirstChar);
    SetWrapMode(WrapAtEdges);

    SetPreEditProc(PreEdit);
    SetPostEditProc(PostEdit);
    SetErrorProc(ErrorHandler);
    EntryCommands.SetHelpProc(DisplayHelp);

  {idSystemName:}
    AddStringField(
      'System Name:', 2, 3,
      CharStr('X', 40), 2, 16, 40,
      hiSystemName, UR^.SystemName);

  {idBbsLocation:}
    AddStringField(
      'Location:', 4, 3,
      CharStr('X', 40), 4, 13, 40,
      hiBbsLocation, UR^.BbsLocation);

  {idBbsPhone:}
    AddStringField(
      'Bbs Phone:', 6, 3,
      'XXXXXXXXXXXXXXX', 6, 14, 15,
      hiBbsPhone, UR^.BbsPhone);

  {idBoardId:}
    AddStringField(
      'Bbs Id:', 6, 39,
      'XXXXXXXX', 6, 47, 8,
      hiBoardId, UR^.BoardId);

  {idSysopName:}
    AddStringField(
      'Sysop Name:', 8, 3,
      CharStr('X', 35), 8, 15, 35,
      hiSysopName, UR^.SysopName);

  {idColor1:}
    AddByteField(
      'Color 1:', 10, 3,
      'KK', 10, 12,
      hiColor1, 0, 255, UR^.Color[1]);

  {idColor2:}
    AddByteField(
      'Color 2:', 10, 16,
      'KK', 10, 25,
      hiColor2, 0, 255, UR^.Color[2]);

  {idColor3:}
    AddByteField(
      'Color 3:', 10, 29,
      'KK', 10, 38,
      hiColor3, 0, 255, UR^.Color[3]);

  {idColor4:}
    AddByteField(
      'Color 4:', 10, 42,
      'KK', 10, 51,
      hiColor4, 0, 255, UR^.Color[4]);

    AddByteField(
      'Color 5:', 10, 55,
      'KK', 10, 64,
      hiColor5, 0, 255, UR^.Color[5]);

  {idDirectWrite:}
    esFieldOptionsOn(efClickExit);
    AddYesNoField(
      'Direct Scrn Writes:', 12, 3,
      'Y', 12, 23,
      hiDirectWrite, UR^.DirectWrite);
    esFieldOptionsOff(efClickExit);

  {idSnowCheck:}
    esFieldOptionsOn(efClickExit);
    AddYesNoField(
      'Snow Checking:', 12, 27,
      'Y', 12, 42,
      hiSnowCheck, UR^.SnowCheck);
    esFieldOptionsOff(efClickExit);

  {idMonoMode:}
    esFieldOptionsOn(efClickExit);
    AddYesNoField(
      'Mono Mode:', 12, 47,
      'Y', 12, 58,
      hiMonoMode, UR^.MonoMode);
    esFieldOptionsOff(efClickExit);

    AddStringField(
      'Printer Name:', 14, 3,
      CharStr('X', 20), 14, 17, 20,
      hiPrnName, UR^.PrnName);

    InitEntryScreen := RawError;
  end;
end;


Procedure DoCfgGen;
  Begin
  New(UR);
  UR^.DirectWrite := Config^.GetDirectWrite;
  UR^.MonoMode := Config^.GetMonoMode;
  UR^.SnowCheck := Config^.GetSnowCheck;
  For i := 1 to 5 Do
    UR^.Color[i] := Config^.GetSystemColor(i);
  UR^.SystemName := Config^.GetBbsName;
  UR^.BbsLocation := Config^.GetBbsLoc;
  UR^.BbsPhone := Config^.GetBbsPhone;
  UR^.SysopName := Config^.GetSysopName;
  UR^.BoardId := Config^.GetBbsId;
  UR^.PrnName := Config^.GetPrnName;
  if MouseInstalled then
    with EsColors do begin
      {activate mouse cursor}
      SoftMouseCursor($0000, (ColorMono(MouseColor, MouseMono) shl 8)+
                             Byte(MouseChar));
      ShowMouse;
      {enable mouse support}
      EntryCommands.cpOptionsOn(cpEnableMouse);
    end;
  Status := InitEntryScreen;
  if Status <> 0 then begin
    WriteLn('Error initializing entry screen: ', Status);
    Halt(1);
  end;
  ES.Process;
  ES.Erase;
  HideMouse;
  ES.Done;
  Config^.SetDirectWrite(UR^.DirectWrite);
  Config^.SetMonoMode(UR^.MonoMode);
  Config^.SetPrnName(UR^.PrnName);
  Config^.SetSnowCheck(UR^.SnowCheck);
  For i := 1 to 5 Do
    Config^.SetSystemColor(i, UR^.Color[i]);
  Config^.SetBbsName(UR^.SystemName);
  Config^.SetBbsLoc(UR^.BbsLocation);
  Config^.SetBbsPhone(UR^.BbsPhone);
  Config^.SetSysopName(UR^.SysopName);
  Config^.SetBbsId(UR^.BoardId);
  Dispose(UR);
  End;


End.
