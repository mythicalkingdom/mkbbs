{$V-}
{$F+}
{$O+}

Unit CFGFILE;

{$I OPDEFINE.INC}

Interface

Procedure DoCfgFile(Area: Word);

Implementation

Uses
  Dos,  OpInline,  OpString,  OpRoot,  OpCrt,  OpColor,  OpMouse,
  OpAbsFld,  OpCmd,  OpField,  OpFrame,  OpWindow,  OpSelect,
  OpEntry, CfgGlob, MKGlobT, CfgSec2, MKCfgAbs;

{Entry field constants}
const
  idName                 = 0;
  idSelect               = idName + 1;
  idFilePath             = idSelect + 1;
  idView                 = idFilePath + 1;
  idDLSec                = idView + 1;
  idULSec                = idDLSec + 1;
  idPFileSec             = idULSec + 1;
  idAllowUL              = idPFileSec + 1;
  idFreeArea             = idAllowUL + 1;
  idIgnoreTime           = idFreeArea + 1;
  idIgnoreBaud           = idIgnoreTime + 1;
  idNewFiles             = idIgnoreBaud + 1;
  idShortName = idNewFiles + 1;

{Help index constants}
const
  hiName                 = 1;
  hiSelect               = hiName + 1;
  hiFilePath             = hiSelect + 1;
  hiView                 = hiFilePath + 1;
  hiDLSec                = hiView + 1;
  hiULSec                = hiDLSec + 1;
  hiPFileSec             = hiULSec + 1;
  hiAllowUL              = hiPFileSec + 1;
  hiFreeArea             = hiAllowUL + 1;
  hiIgnoreTime           = hiFreeArea + 1;
  hiIgnoreBaud           = hiIgnoreTime + 1;
  hiNewFiles             = hiIgnoreBaud + 1;
  hiShortName = hiNewFiles + 1;

Type UserRecord = Record
  AreaNum: Word;
  Name: String[40];
  Select: String[10];
  FilePath: String[60];
  ULSec: SecType;
  DLSec: SecType;
  ViewSec: SecType;
  PFileSec: SecType;
  NewFiles: Boolean;
  AllowUL: Boolean;
  FreeArea: Boolean;
  IgnoreTime: Boolean;
  IgnoreBaud: Boolean;
  ShortName: String[12];
  End;


Var
  ES     : EntryScreen;
  Status : Word;
  UR: ^UserRecord;


procedure PreEdit(ESP : EntryScreenPtr);
  {-Called just before a field is edited}

begin
  with ESP^ do
    case GetCurrentID of
      idName: ;
      idSelect: ;
      idFilePath: ;
      idView: GetSecurity(UR^.ViewSec, ESP, idView, '[ View Security ]');
      idDLSec: GetSecurity(UR^.DLSec, ESP, idDLSec,'[ DL Security ]');
      idULSec: GetSecurity(UR^.ULSec, ESP, idULSec,'[ UL Security ]');
      idPFileSec: GetSecurity(UR^.PFileSec, ESP, idPFileSec,
        '[ PFile Security ]');
      idAllowUL              : ;
      idFreeArea             : ;
      idIgnoreTime           : ;
      idIgnoreBaud           : ;
      idNewFiles             : ;
    end;
end;

procedure PostEdit(ESP : EntryScreenPtr);
  {-Called just after a field has been edited}
begin
  with ESP^ do
    case GetCurrentID of
      idName                 : ;
      idSelect               : ;
      idFilePath             : ;
      idView                 : ;
      idDLSec                : ;
      idULSec                : ;
      idPFileSec             : ;
      idAllowUL              : ;
      idFreeArea             : ;
      idIgnoreTime           : ;
      idIgnoreBaud           : ;
      idNewFiles             : ;
    end;
end;

procedure IncChoice(var Value; ID : Word; Factor : Integer; var St : string);
  {-Increment a multiple choice field value and convert it to a string}
begin
end;

procedure ErrorHandler(UnitCode : Byte; var ErrCode : Word; Msg : string);
  {-Report errors}
begin
  RingBell;
end;

procedure DisplayHelp(UnitCode : Byte; IdPtr : Pointer; HelpIndex : Word);
  {-Display context sensitive help}
begin
end;

function InitEntryScreen : Word;
  {-Initialize entry screen generated by MAKESCRN}
const
  WinOptions = wBordered+wClear+wUserContents;

  Begin
  with ES do begin
    if not InitCustom(5, 6, 74, 18, EsColors, WinOptions) then begin
      InitEntryScreen := InitStatus;
      Exit;
    end;

    wFrame.SetFrameType(Frame1);
    wFrame.AddShadow(shBR, shSeeThru);
    wFrame.AddHeader('[ File Area ' + Long2Str(UR^.AreaNum) + ' Configuration ]', heTC);
    esFieldOptionsOn(efCursorToEnd+efClearFirstChar);
    SetWrapMode(WrapAtEdges);

    SetPreEditProc(PreEdit);
    SetPostEditProc(PostEdit);
    SetErrorProc(ErrorHandler);
    EntryCommands.SetHelpProc(DisplayHelp);

  {idName:}
    AddStringField(
      'Name:', 2, 4,
      CharStr('X', 30), 2, 10, 30,
      hiName, UR^.Name);

  {idSelect:}
    AddStringField(
      'Select:', 2, 45,
      'XXXX', 2, 53, 4,
      hiSelect, UR^.Select);

  {idFilePath:}
    AddStringField(
      'File Path:', 4, 4,
      CharStr('X', 50), 4, 15, 50,
      hiFilePath, UR^.FilePath);

  {idView:}
    AddWordField(
      'View Security:', 6, 4,
      '99999', 6, 19,
      hiView, 0, 65535, UR^.ViewSec.Level);

  {idDLSec:}
    AddWordField(
      'DL Security:', 6, 28,
      '99999', 6, 41,
      hiDLSec, 0, 65535, UR^.DLSec.Level);

  {idULSec:}
    AddWordField(
      'UL Security:', 6, 50,
      '99999', 6, 63,
      hiULSec, 0, 65535, UR^.ULSec.Level);

  {idPFileSec:}
    AddWordField(
      'PFileSecurity:', 8, 4,
      '99999', 8, 19,
      hiPFileSec, 0, 65535, UR^.PFileSec.Level);

  {idAllowUL:}
    esFieldOptionsOn(efClickExit);
    AddYesNoField(
      'Allow Uploads:', 8, 28,
      'Y', 8, 43,
      hiAllowUL, UR^.AllowUL);
    esFieldOptionsOff(efClickExit);

  {idFreeArea:}
    esFieldOptionsOn(efClickExit);
    AddYesNoField(
      'Free File Area:', 8, 50,
      'Y', 8, 66,
      hiFreeArea, UR^.FreeArea);
    esFieldOptionsOff(efClickExit);

  {idIgnoreTime:}
    esFieldOptionsOn(efClickExit);
    AddYesNoField(
      'Ignore Time Limits:', 10, 4,
      'Y', 10, 24,
      hiIgnoreTime, UR^.IgnoreTime);
    esFieldOptionsOff(efClickExit);

  {idIgnoreBaud:}
    esFieldOptionsOn(efClickExit);
    AddYesNoField(
      'Ignore Baud Limits:', 10, 42,
      'Y', 10, 62,
      hiIgnoreBaud, UR^.IgnoreBaud);
    esFieldOptionsOff(efClickExit);

  {idNewFiles:}
    esFieldOptionsOn(efClickExit);
    AddYesNoField(
      'Include in New Files:', 12, 4,
      'Y', 12, 26,
      hiNewFiles, UR^.NewFiles);
    esFieldOptionsOff(efClickExit);

    AddStringField(
      'Short Name:', 12, 30,
      'XXXXXXXXXXXX', 12, 42, 12,
      hiShortName, UR^.ShortName);

    InitEntryScreen := RawError;
  end;
end;


Procedure DoCfgFile(Area: Word);
  Begin
  New(UR);
  UR^.AreaNum := Area;
  UR^.Name := Config^.GetFileAreaName(Area);
  UR^.ShortName := Config^.GetFileShortName(Area);
  UR^.Select := Config^.GetFileSelect(Area);
  UR^.FilePath := Config^.GetFileAreaPath(Area);
  Config^.GetFileViewSecurity(Area, UR^.ViewSec);
  Config^.GetFileULSecurity(Area, UR^.ULSec);
  Config^.GetFileDLSecurity(Area, UR^.DLSec);
  Config^.GetFilePvtSecurity(Area, UR^.PFileSec);
  UR^.AllowUL := Not Config^.GetFileNoUL(Area);
  UR^.NewFiles := Not Config^.GetFileNoNew(Area);
  UR^.FreeArea := Config^.GetFileFree(Area);
  UR^.IgnoreTime := Config^.GetFileNoTime(Area);
  UR^.IgnoreBaud := Config^.GetFileNoBaud(Area);
  if MouseInstalled then
    with EsColors do begin
      {activate mouse cursor}
      SoftMouseCursor($0000, (ColorMono(MouseColor, MouseMono) shl 8)+
                             Byte(MouseChar));
      ShowMouse;
      {enable mouse support}
      EntryCommands.cpOptionsOn(cpEnableMouse);
    end;
  Status := InitEntryScreen;
  if Status <> 0 then begin
    WriteLn('Error initializing entry screen: ', Status);
    Halt(1);
  end;
  ES.Process;
  ES.Erase;
  HideMouse;
  ES.Done;
  Config^.SetFileAreaName(Area, UR^.Name);
  Config^.SetFileShortName(Area, UR^.ShortName);
  Config^.SetFileSelect(Area, UR^.Select);
  Config^.SetFileAreaPath(Area, UR^.FilePath);
  Config^.SetFileViewSecurity(Area, UR^.ViewSec);
  Config^.SetFileULSecurity(Area, UR^.ULSec);
  Config^.SetFileDLSecurity(Area, UR^.DLSec);
  Config^.SetFilePvtSecurity(Area, UR^.PFileSec);
  Config^.SetFileNoUL(Area, Not UR^.AllowUL);
  Config^.SetFileNoNew(Area, Not UR^.NewFiles);
  Config^.SetFileFree(Area, UR^.FreeArea);
  Config^.SetFileNoTime(Area, UR^.IgnoreTime);
  Config^.SetFileNoBaud(Area, UR^.IgnoreBaud);
  Dispose(UR);
  End;


End.
