{$V-}
{$F+}
{$O+}

Unit CFGRESP;


{$I OPDEFINE.INC}


Interface

Procedure DoCfgResp;

Implementation

uses
  Dos,  OpInline,  OpString,  OpRoot,  OpCrt,  OpColor,
  OpMouse,  OpAbsFld,  OpCmd,  OpField,  OpFrame,  OpWindow,
  OpSelect,  OpEntry, CfgGlob, MKGlobT, MKCfgAbs;

const
  MouseChar  : Char = #04;

{Entry field constants}
const
  idb300                 = 0;
  idb1200                = idb300 + 1;
  idb2400                = idb1200 + 1;
  idb4800                = idb2400 + 1;
  idb7200                = idb4800 + 1;
  idb9600                = idb7200 + 1;
  idb12000               = idb9600 + 1;
  idb14400               = idb12000 + 1;
  idb19200               = idb14400 + 1;
  idb38400               = idb19200 + 1;
  idResponse             = idb38400 + 1;
  idRingStr              = idResponse + 1;

{Help index constants}
const
  hib300                 = 1;
  hib1200                = hib300 + 1;
  hib2400                = hib1200 + 1;
  hib4800                = hib2400 + 1;
  hib7200                = hib4800 + 1;
  hib9600                = hib7200 + 1;
  hib12000               = hib9600 + 1;
  hib14400               = hib12000 + 1;
  hib19200               = hib14400 + 1;
  hib38400               = hib19200 + 1;
  hiResponse             = hib38400 + 1;
  hiRingStr              = hiResponse + 1;

type UserRecord = record
      b300                 : string[40];
      b1200                : string[40];
      b2400                : string[40];
      b4800                : string[40];
      b7200                : string[40];
      b9600                : string[40];
      b12000               : string[40];
      b14400               : string[40];
      b19200               : string[40];
      b38400               : string[40];
      Response             : string[40];
      RingStr              : string[40];
    end;

var
  ES: EntryScreen;
  UR: ^UserRecord;
  Status : Word;


procedure PreEdit(ESP : EntryScreenPtr);
  {-Called just before a field is edited}
begin
  with ESP^ do
    case GetCurrentID of
      idb300                 : ;
      idb1200                : ;
      idb2400                : ;
      idb4800                : ;
      idb7200                : ;
      idb9600                : ;
      idb12000               : ;
      idb14400               : ;
      idb19200               : ;
      idb38400               : ;
      idResponse             : ;
      idRingStr              : ;
    end;
end;

procedure PostEdit(ESP : EntryScreenPtr);
  {-Called just after a field has been edited}
begin
  with ESP^ do
    case GetCurrentID of
      idb300                 : ;
      idb1200                : ;
      idb2400                : ;
      idb4800                : ;
      idb7200                : ;
      idb9600                : ;
      idb12000               : ;
      idb14400               : ;
      idb19200               : ;
      idb38400               : ;
      idResponse             : ;
      idRingStr              : ;
    end;
end;

procedure IncChoice(var Value; ID : Word; Factor : Integer; var St : string);
  {-Increment a multiple choice field value and convert it to a string}
begin
end;

procedure ErrorHandler(UnitCode : Byte; var ErrCode : Word; Msg : string);
  {-Report errors}
begin
  RingBell;
end;

procedure DisplayHelp(UnitCode : Byte; IdPtr : Pointer; HelpIndex : Word);
  {-Display context sensitive help}
begin
end;

function InitEntryScreen : Word;
  {-Initialize entry screen generated by MAKESCRN}
const
  WinOptions = wBordered+wClear+wUserContents;
begin
  with ES do begin
    if not InitCustom(10, 6, 67, 20, EsColors, WinOptions) then begin
      InitEntryScreen := InitStatus;
      Exit;
    end;

    wFrame.SetFrameType(Frame1);
    wFrame.AddShadow(shBR, shSeeThru);
    wFrame.AddHeader('[ Modem Response Strings ]', heTC);
    esFieldOptionsOn(efCursorToEnd+efClearFirstChar);
    SetWrapMode(WrapAtEdges);

    SetPreEditProc(PreEdit);
    SetPostEditProc(PostEdit);
    SetErrorProc(ErrorHandler);
    EntryCommands.SetHelpProc(DisplayHelp);

  {idb300:}
    AddStringField(
      '  300:', 2, 7,
      CharStr('X', 40), 2, 14, 40,
      hib300, UR^.b300);

  {idb1200:}
    AddStringField(
      ' 1200:', 3, 7,
      CharStr('X', 40), 3, 14, 40,
      hib1200, UR^.b1200);

  {idb2400:}
    AddStringField(
      ' 2400:', 4, 7,
      CharStr('X', 40), 4, 14, 40,
      hib2400, UR^.b2400);

  {idb4800:}
    AddStringField(
      ' 4800:', 5, 7,
      CharStr('X', 40), 5, 14, 40,
      hib4800, UR^.b4800);

  {idb7200:}
    AddStringField(
      ' 7200:', 6, 7,
      CharStr('X', 40), 6, 14, 40,
      hib7200, UR^.b7200);

  {idb9600:}
    AddStringField(
      ' 9600:', 7, 7,
      CharStr('X', 40), 7, 14, 40,
      hib9600, UR^.b9600);

  {idb12000:}
    AddStringField(
      '12000:', 8, 7,
      CharStr('X', 40), 8, 14, 40,
      hib12000, UR^.b12000);

  {idb14400:}
    AddStringField(
      '14400:', 9, 7,
      CharStr('X', 40), 9, 14, 40,
      hib14400, UR^.b14400);

  {idb19200:}
    AddStringField(
      '19200:', 10, 7,
      CharStr('X', 40), 10, 14, 40,
      hib19200, UR^.b19200);

  {idb38400:}
    AddStringField(
      '38400:', 11, 7,
      CharStr('X', 40), 11, 14, 40,
      hib38400, UR^.b38400);

  {idResponse:}
    AddStringField(
      'Response:', 13, 7,
      CharStr('X', 40), 13, 17, 40,
      hiResponse, UR^.Response);

  {idRingStr:}
    AddStringField(
      'Ring:', 14, 7,
      CharStr('X', 40), 14, 13, 40,
      hiRingStr, UR^.RingStr);

    InitEntryScreen := RawError;
  end;
end;

{*** sample test code follows ***}

Procedure DoCfgResp;
  Begin
  New(UR);
  UR^.b300 := Config^.GetModemResp(2);
  UR^.b1200 := Config^.GetModemResp(3);
  UR^.b2400 := Config^.GetModemResp(4);
  UR^.b4800 := Config^.GetModemResp(5);
  UR^.b7200 := Config^.GetModemResp(6);
  UR^.b9600 := Config^.GetModemResp(7);
  UR^.b12000 := Config^.GetModemResp(8);
  UR^.b14400 := Config^.GetModemResp(9);
  UR^.b19200 := Config^.GetModemResp(10);
  UR^.b38400 := Config^.GetModemResp(11);
  UR^.Response := '';
  UR^.RingStr := '';
  if MouseInstalled then
    with EsColors do begin
      {activate mouse cursor}
      SoftMouseCursor($0000, (ColorMono(MouseColor, MouseMono) shl 8)+
                             Byte(MouseChar));
      ShowMouse;
      {enable mouse support}
      EntryCommands.cpOptionsOn(cpEnableMouse);
    end;
  Status := InitEntryScreen;
  if Status <> 0 then begin
    WriteLn('Error initializing entry screen: ', Status);
    Halt(1);
  end;
  ES.Process;
  ES.Erase;
  HideMouse;
  ES.Done;
  Config^.SetModemResp(2, UR^.b300);
  Config^.SetModemResp(3, UR^.b1200);
  Config^.SetModemResp(4, UR^.b2400);
  Config^.SetModemResp(5, UR^.b4800);
  Config^.SetModemResp(6, UR^.b7200);
  Config^.SetModemResp(7, UR^.b9600);
  Config^.SetModemResp(8, UR^.b12000);
  Config^.SetModemResp(9, UR^.b14400);
  Config^.SetModemResp(10, UR^.b19200);
  Config^.SetModemResp(11, UR^.b38400);
  UR^.Response := '';
  UR^.RingStr := '';
  Dispose(UR);
  End;


End.
