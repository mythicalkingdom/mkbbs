{$V-}
{$F+}
{$O+}

Unit CFGXFER;


Interface

Procedure DoCfgXfer;

Implementation

{$I OPDEFINE.INC}

uses
  Dos,  OpInline,  OpString,  OpRoot,  OpCrt,  OpColor,  OpMouse,
  OpAbsFld,  OpCmd,  OpField,  OpFrame,  OpWindow,  OpSelect,
  OpEntry, CfgGlob, MKGlobT, MKCfgAbs;

{Entry field constants}
const
  idDLStartH             = 0;
  idDLStartM             = idDLStartH + 1;
  idDownloadStopH        = idDLStartM + 1;
  idDownloadStopM        = idDownloadStopH + 1;
  idLoBaudH              = idDownloadStopM + 1;
  idLowBaudM             = idLoBaudH + 1;
  idLowBaudStopH         = idLowBaudM + 1;
  idLowBaudStopM         = idLowBaudStopH + 1;
  idXferBaud             = idLowBaudStopM + 1;
  idULCredit             = idXferBaud + 1;
  idMinDesc              = idULCredit + 1;
  idMaxDesc              = idMinDesc + 1;
  idMixULSpace           = idMaxDesc + 1;
  idAskFiles             = idMixULSpace + 1;
  idForceFiles           = idAskFiles + 1;

{Help index constants}
const
  hiDLStartH             = 1;
  hiDLStartM             = hiDLStartH + 1;
  hiDownloadStopH        = hiDLStartM + 1;
  hiDownloadStopM        = hiDownloadStopH + 1;
  hiLoBaudH              = hiDownloadStopM + 1;
  hiLowBaudM             = hiLoBaudH + 1;
  hiLowBaudStopH         = hiLowBaudM + 1;
  hiLowBaudStopM         = hiLowBaudStopH + 1;
  hiXferBaud             = hiLowBaudStopM + 1;
  hiULCredit             = hiXferBaud + 1;
  hiMinDesc              = hiULCredit + 1;
  hiMaxDesc              = hiMinDesc + 1;
  hiMixULSpace           = hiMaxDesc + 1;
  hiAskFiles             = hiMixULSpace + 1;
  hiForceFiles           = hiAskFiles + 1;


Type UserRecord = Record
  DLStartH: Byte;
  DLStartM: Byte;
  DownloadStopH: Byte;
  DownloadStopM: Byte;
  LowBaudH: Byte;
  LowBaudM: Byte;
  LowBaudStopH: Byte;
  LowBaudStopM: Byte;
  XferBaud: Word;
  ULCredit: Word;
  MinDesc: Byte;
  MaxDesc: Byte;
  MinULSpace: LongInt;
  AskFiles: Boolean;
  ForceFiles: Boolean;
  End;

Var
  ES: EntryScreen;
  UR: ^UserRecord;
  Status : Word;
  Tmp: Word;

procedure PreEdit(ESP : EntryScreenPtr);
  {-Called just before a field is edited}
begin
  with ESP^ do
    case GetCurrentID of
      idDLStartH             : ;
      idDLStartM             : ;
      idDownloadStopH        : ;
      idDownloadStopM        : ;
      idLoBaudH              : ;
      idLowBaudM             : ;
      idLowBaudStopH         : ;
      idLowBaudStopM         : ;
      idXferBaud             : ;
      idULCredit             : ;
      idMinDesc              : ;
      idMaxDesc              : ;
      idMixULSpace           : ;
      idAskFiles             : ;
      idForceFiles           : ;
    end;
end;

procedure PostEdit(ESP : EntryScreenPtr);
  {-Called just after a field has been edited}
begin
  with ESP^ do
    case GetCurrentID of
      idDLStartH             : ;
      idDLStartM             : ;
      idDownloadStopH        : ;
      idDownloadStopM        : ;
      idLoBaudH              : ;
      idLowBaudM             : ;
      idLowBaudStopH         : ;
      idLowBaudStopM         : ;
      idXferBaud             : ;
      idULCredit             : ;
      idMinDesc              : ;
      idMaxDesc              : ;
      idMixULSpace           : ;
      idAskFiles             : ;
      idForceFiles           : ;
    end;
end;

procedure IncChoice(var Value; ID : Word; Factor : Integer; var St : string);
  {-Increment a multiple choice field value and convert it to a string}
begin
end;

procedure ErrorHandler(UnitCode : Byte; var ErrCode : Word; Msg : string);
  {-Report errors}
begin
  RingBell;
end;

procedure DisplayHelp(UnitCode : Byte; IdPtr : Pointer; HelpIndex : Word);
  {-Display context sensitive help}
begin
end;

function InitEntryScreen : Word;
  {-Initialize entry screen generated by MAKESCRN}

const
  WinOptions = wBordered+wClear+wUserContents;
begin
  with ES do begin
    if not InitCustom(7, 6, 71, 20, EsColors, WinOptions) then begin
      InitEntryScreen := InitStatus;
      Exit;
    end;

    wFrame.SetFrameType(Frame1);
    wFrame.AddShadow(shBR, shSeeThru);
    wFrame.AddHeader('[ File Transfer Configuration ]', heTC);
    esFieldOptionsOn(efCursorToEnd+efClearFirstChar);
    SetWrapMode(WrapAtEdges);

    SetPreEditProc(PreEdit);
    SetPostEditProc(PostEdit);
    SetErrorProc(ErrorHandler);
    EntryCommands.SetHelpProc(DisplayHelp);

    SetPadChar('0');
  {idDLStartH:}
    AddNumericByteField(
      'Download Start Time:', 2, 3,
      '99', 2, 24,
      hiDLStartH, 0, 24, UR^.DLStartH);

  {idDLStartM:}
    AddNumericByteField(
      ':', 2, 26,
      '99', 2, 27,
      hiDLStartM, 0, 59, UR^.DLStartM);

  {idDownloadStopH:}
    AddNumericByteField(
      'Download Stop Time:', 2, 35,
      '99', 2, 55,
      hiDownloadStopH, 0, 24, UR^.DownLoadStopH);

  {idDownloadStopM:}
    AddNumericByteField(
      ':', 2, 57,
      '99', 2, 58,
      hiDownloadStopM, 0, 59, UR^.DownloadStopM);

  {idLoBaudH:}
    AddNumericByteField(
      'Low Baud Start:', 4, 3,
      '99', 4, 19,
      hiLoBaudH, 0, 24, UR^.LowBaudH);

  {idLowBaudM:}
    AddNumericByteField(
      ':', 4, 21,
      '99', 4, 22,
      hiLowBaudM, 0, 59, UR^.LowBaudM);

  {idLowBaudStopH:}
    AddNumericByteField(
      'Low Baud Stop:', 4, 35,
      '99', 4, 50,
      hiLowBaudStopH, 0, 24, UR^.LowBaudStopH);

  {idLowBaudStopM:}
    AddNumericByteField(
      ':', 4, 52,
      '99', 4, 53,
      hiLowBaudStopM, 0, 59, UR^.LowBaudStopM);

  SetPadChar(' ');

  {idXferBaud:}
    AddWordField(
      'Minimum Transfer Baud Rate:', 6, 3,
      '99999', 6, 31,
      hiXferBaud, 0, 65535, UR^.XferBaud);

  {idULCredit:}
    AddWordField(
      'Upload Credit:', 6, 40,
      '99999', 6, 55,
      hiULCredit, 0, 65535, UR^.ULCredit);

  {idMinDesc:}
    AddByteField(
      'Min Description Length:', 8, 3,
      '999', 8, 27,
      hiMinDesc, 0, 255, UR^.MinDesc);

  {idMaxDesc:}
    AddByteField(
      'Max Description Length:', 8, 35,
      '999', 8, 59,
      hiMaxDesc, 1, 240, UR^.MaxDesc);

  {idMixULSpace:}
    AddLongField(
      'Minumum free UL Space:', 10, 3,
      '999999999', 10, 26,
      hiMixULSpace, 0, $7FFFFFFF, UR^.MinULSpace);

  {idAskFiles:}
    esFieldOptionsOn(efClickExit);
    AddYesNoField(
      'Ask New File Seach at Log-in:', 12, 3,
      'Y', 12, 33,
      hiAskFiles, UR^.AskFiles);
    esFieldOptionsOff(efClickExit);

  {idForceFiles:}
    esFieldOptionsOn(efClickExit);
    AddYesNoField(
      'Force New Files Search at Log-in:', 14, 3,
      'Y', 14, 37,
      hiForceFiles, UR^.ForceFiles);
    esFieldOptionsOff(efClickExit);

    InitEntryScreen := RawError;
  end;
end;



Procedure DoCfgXfer;
  Begin
  New(UR);
  UR^.DLStartH := Hi(Config^.GetDLStart);
  UR^.DLStartM := Lo(Config^.GetDLStart);
  UR^.DownloadStopH := Hi(Config^.GetDLStop);
  UR^.DownloadStopM := Lo(Config^.GetDLStop);
  UR^.LowBaudH := Hi(Config^.GetLoBaudStart);
  UR^.LowBaudM := Lo(Config^.GetLoBaudStart);
  UR^.LowBaudStopH := Hi(Config^.GetLoBaudStop);
  UR^.LowBaudStopM := Lo(Config^.GetLoBaudStop);
  UR^.XferBaud := Config^.GetMinXferBaud;
  UR^.ULCredit := Config^.GetULCredit;
  UR^.MinDesc := Config^.GetMinDesc;
  UR^.MaxDesc := Config^.GetMaxDesc;
  UR^.MinULSpace := Config^.GetMinFree;
  UR^.AskFiles := Config^.GetAskNewFiles;
  UR^.ForceFiles := Config^.GetForceNewFiles;
  if MouseInstalled then
    with EsColors do begin
      {activate mouse cursor}
      SoftMouseCursor($0000, (ColorMono(MouseColor, MouseMono) shl 8)+
                             Byte(MouseChar));
      ShowMouse;
      {enable mouse support}
      EntryCommands.cpOptionsOn(cpEnableMouse);
    end;
  Status := InitEntryScreen;
  if Status <> 0 then begin
    WriteLn('Error initializing entry screen: ', Status);
    Halt(1);
  end;
  ES.Process;
  ES.Erase;
  HideMouse;
  ES.Done;
  Tmp := UR^.DLStartH;
  Tmp := (Tmp shl 8) + UR^.DLStartM;
  Config^.SetDLStart(Tmp);
  Tmp := UR^.DownloadStopH;
  Tmp := (Tmp shl 8) + UR^.DownloadStopM;
  Config^.SetDLStop(Tmp);
  Tmp := UR^.LowBaudH;
  Tmp := (Tmp shl 8) + UR^.LowBaudM;
  Config^.SetLoBaudStart(Tmp);
  Tmp := UR^.LowbaudStopH;
  Tmp := (Tmp shl 8) + UR^.LowBaudStopM;
  Config^.SetLoBaudStop(Tmp);
  Config^.SetMinXferBaud(UR^.XferBaud);
  Config^.SetULCredit(UR^.ULCredit);
  Config^.SetMinDesc(UR^.MinDesc);
  Config^.SetMaxDesc(UR^.MaxDesc);
  Config^.SetMinFree(UR^.MinULSpace);
  Config^.SetAskNewFiles(UR^.AskFiles);
  Config^.SetForceNewFiles(UR^.ForceFiles);
  Dispose(UR);
  End;


End.
