{$V-}

Unit CFGLANG;

{$I OPDEFINE.INC}

Interface

Procedure DoCfgLang(LN: Word);

Implementation


uses
  Dos,  OpInline,  OpString,  OpRoot,  OpCrt,  OpColor,
  OpMouse,  OpAbsFld,  OpCmd,  OpField,  OpFrame,  OpWindow,
  OpSelect,  OpEntry, CfgGlob, MKGlobT, MKString, MKCfgAbs;

const
  idName                 = 0;
  idFileName             = idName + 1;
  idMenuPath             = idFileName + 1;
  idTxtPath              = idMenuPath + 1;
  idQuesPath = idTxtPath + 1;

const
  hiName                 = 1;
  hiFileName             = hiName + 1;
  hiMenuPath             = hiFileName + 1;
  hiTxtPath              = hiMenuPath + 1;
  hiQuesPath = hiTxtPath + 1;


Type UserRecord = Record
  Name: String[10];
  FileName: String[8];
  MenuPath: String[60];
  TxtPath: String[60];
  QuesPath: String[60];
  End;

var
  ES: EntryScreen;
  Status : Word;
  UR: ^UserRecord;

{$F+}
procedure PreEdit(ESP : EntryScreenPtr);
  {-Called just before a field is edited}
begin
  with ESP^ do
    case GetCurrentID of
      idName                 : ;
      idFileName             : ;
      idMenuPath             : ;
      idTxtPath              : ;
    end;
end;

procedure PostEdit(ESP : EntryScreenPtr);
  {-Called just after a field has been edited}
begin
  with ESP^ do
    case GetCurrentID of
      idName                 : ;
      idFileName             : ;
      idMenuPath: Begin
                  AddBackSlash(UR^.MenuPath);
                  ESP^.DrawField(idMenuPath);
                  End;
      idTxtPath: Begin
                 AddBackSlash(UR^.TxtPath);
                 ESP^.DrawField(idTxtPath);
                 End;
      idQuesPath: Begin
                 AddBackSlash(UR^.QuesPath);
                 ESP^.DrawField(idQuesPath);
                 End;
    end;
end;

procedure IncChoice(var Value; ID : Word; Factor : Integer; var St : string);
  {-Increment a multiple choice field value and convert it to a string}
begin
end;

procedure ErrorHandler(UnitCode : Byte; var ErrCode : Word; Msg : string);
  {-Report errors}
begin
  RingBell;
end;

procedure DisplayHelp(UnitCode : Byte; IdPtr : Pointer; HelpIndex : Word);
  {-Display context sensitive help}
begin
end;
{$F-}

function InitEntryScreen : Word;
  {-Initialize entry screen generated by MAKESCRN}
const
  Frame1 = '…»ªºÕÕ∫∫';
  WinOptions = wBordered+wClear+wUserContents;
begin
  with ES do begin
    if not InitCustom(5, 5, 75, 13, EsColors, WinOptions) then begin
      InitEntryScreen := InitStatus;
      Exit;
    end;

    wFrame.SetFrameType(Frame1);
    wFrame.AddHeader('[ Language Configuration ]', heTC);
    wFrame.AddShadow(shBR, shSeeThru);
    esFieldOptionsOn(efCursorToEnd+efClearFirstChar);
    SetWrapMode(WrapAtEdges);

    SetPreEditProc(PreEdit);
    SetPostEditProc(PostEdit);
    SetErrorProc(ErrorHandler);
    EntryCommands.SetHelpProc(DisplayHelp);

  {idName:}
    AddStringField(
      'Language Name:', 2, 4,
      'XXXXXXXXXX', 2, 19, 10,
      hiName, UR^.Name);

  {idFileName:}
    AddStringField(
      'File Name:', 2, 37,
      'XXXXXXXX', 2, 48, 8,
      hiFileName, UR^.FileName);

  {idMenuPath:}
    AddStringField(
      'Menu Path:', 4, 4,
      CharStr('X', 50), 4, 15, 50,
      hiMenuPath, UR^.MenuPath);

  {idTxtPath:}
    AddStringField(
      'Screens Path:', 6, 4,
      CharStr('X', 50), 6, 18, 50,
      hiTxtPath, UR^.TxtPath);

    AddStringField(
      'Q-A Path:', 8, 4,
      CharStr('X', 50), 8, 14, 50,
      hiQuesPath, UR^.QuesPath);

    InitEntryScreen := RawError;
  end;
end;


Procedure DoCfgLang(LN: Word);
  Begin
  New(UR);
  UR^.Name := Config^.GetLangName(LN);
  UR^.FileName := Config^.GetLangFile(LN);
  UR^.MenuPath := Config^.GetMnuPath(LN);
  UR^.TxtPath := Config^.GetTxtPath(LN);
  UR^.QuesPath := Config^.GetLangQuesPath(LN);
  if MouseInstalled then
    with EsColors do begin
      {activate mouse cursor}
      SoftMouseCursor($0000, (ColorMono(MouseColor, MouseMono) shl 8)+
                             Byte(MouseChar));
      ShowMouse;
      {enable mouse support}
      EntryCommands.cpOptionsOn(cpEnableMouse);
    end;
  Status := InitEntryScreen;
  if Status <> 0 then begin
    WriteLn('Error initializing entry screen: ', Status);
    Halt(1);
  end;
  ES.Process;
  ES.Erase;
  HideMouse;
  ES.Done;
  Config^.SetLangName(LN, UR^.Name);
  Config^.SetLangFile(LN, UR^.FileName);
  Config^.SetMnuPath(LN, UR^.MenuPath);
  Config^.SetTxtPath(LN, UR^.TxtPath);
  Config^.SetLangQuesPath(LN, UR^.QuesPath);
  Dispose(UR);
  End;


End.
