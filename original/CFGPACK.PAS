{$V-}

Unit CFGPACK;

{$I OPDEFINE.INC}


Interface
  Procedure DoCfgPack(PN: Word);

Implementation

Uses
  Dos,  OpInline,  OpString,  OpRoot,  OpCrt,
  OpColor,  OpMouse,  OpAbsFld,  OpCmd,  OpField,  OpFrame,
  OpWindow,  OpSelect,  OpEntry, CfgGlob, MKCfgAbs;


{Entry field constants}
const
  idName                 = 0;
  idKey                  = idName + 1;
  idAvail                = idKey + 1;
  idPackCmd              = idAvail + 1;
  idUnPackCmd            = idPackCmd + 1;

{Help index constants}
const
  hiName                 = 1;
  hiKey                  = hiName + 1;
  hiAvail                = hiKey + 1;
  hiPackCmd              = hiAvail + 1;
  hiUnPackCmd            = hiPackCmd + 1;

type
  UserRecord =
    record
      Name                 : string[10];
      Key                  : Char;
      Avail                : Boolean;
      PackCmd              : string[80];
      UnPackCmd            : string[80];
      PackStr: String[7];
    end;

var
  ES     : EntryScreen;
  UR: ^UserRecord;
  Status : Word;

{$F+}
procedure PreEdit(ESP : EntryScreenPtr);
  {-Called just before a field is edited}
begin
  with ESP^ do
    case GetCurrentID of
      idName                 : ;
      idKey                  : ;
      idAvail                : ;
      idPackCmd              : ;
      idUnPackCmd            : ;
    end;
end;

procedure PostEdit(ESP : EntryScreenPtr);
  {-Called just after a field has been edited}
begin
  with ESP^ do
    case GetCurrentID of
      idName                 : ;
      idKey                  : ;
      idAvail                : ;
      idPackCmd              : ;
      idUnPackCmd            : ;
    end;
end;

procedure IncChoice(var Value; ID : Word; Factor : Integer; var St : string);
  {-Increment a multiple choice field value and convert it to a string}
begin
end;

procedure ErrorHandler(UnitCode : Byte; var ErrCode : Word; Msg : string);
  {-Report errors}
begin
  RingBell;
end;

procedure DisplayHelp(UnitCode : Byte; IdPtr : Pointer; HelpIndex : Word);
  {-Display context sensitive help}
begin
end;
{$F-}

function InitEntryScreen : Word;
  {-Initialize entry screen generated by MAKESCRN}
const
  Frame1 = '…»ªºÕÕ∫∫';
  WinOptions = wBordered+wClear+wUserContents;
begin
  with ES do begin
    if not InitCustom(5, 5, 76, 11, EsColors, WinOptions) then begin
      InitEntryScreen := InitStatus;
      Exit;
    end;

    wFrame.SetFrameType(Frame1);
    wFrame.AddShadow(shBR, shSeeThru);
    wFrame.AddHeader(UR^.PackStr, heTC);
    esFieldOptionsOn(efCursorToEnd+efClearFirstChar);
    SetWrapMode(WrapAtEdges);

    SetPreEditProc(PreEdit);
    SetPostEditProc(PostEdit);
    SetErrorProc(ErrorHandler);
    EntryCommands.SetHelpProc(DisplayHelp);

  {idName:}
    AddStringField(
      'Name:', 2, 3,
      'XXXXXXXXXX', 2, 9, 10,
      hiName, UR^.Name);

  {idKey:}
    esFieldOptionsOff(efTrimBlanks);
    AddCharField(
      'Key:', 2, 24,
      'X', 2, 29,
      hiKey, #0, #0, UR^.Key);
    esFieldOptionsOn(efTrimBlanks);

  {idAvail:}
    esFieldOptionsOn(efClickExit);
    AddYesNoField(
      'Available:', 2, 37,
      'Y', 2, 48,
      hiAvail, UR^.Avail);
    esFieldOptionsOff(efClickExit);

  {idPackCmd:}
    AddStringField(
      'Pack Cmd Line:', 4, 3,
      CharStr('X', 80), 4, 18, 50,
      hiPackCmd, UR^.PackCmd);

  {idUnPackCmd:}
    AddStringField(
      'UnPack Cmd Line:', 6, 3,
      CharStr('X', 80), 6, 20, 50,
      hiUnPackCmd, UR^.UnPackCmd);

    InitEntryScreen := RawError;
  end;
end;


Procedure DoCfgPack(PN: Word);
  Begin
  New(UR);
  Case PN of
    1: UR^.PackStr := '[ LZH ]';
    2: UR^.PackStr := '[ ZIP ]';
    3: UR^.PackStr := '[ ARC ]';
    4: UR^.PackStr := '[ ZOO ]';
    5: UR^.PackStr := '[ DWC ]';
    6: UR^.PackStr := '[ ARJ ]';
    7: UR^.PackStr := '[ HYP ]';
    Else
      UR^.PackStr := '[ ??? ]';
    End;
  if MouseInstalled then
    with EsColors do begin
      {activate mouse cursor}
      SoftMouseCursor($0000, (ColorMono(MouseColor, MouseMono) shl 8)+
                             Byte(MouseChar));
      ShowMouse;
      {enable mouse support}
      EntryCommands.cpOptionsOn(cpEnableMouse);
    end;
  Status := InitEntryScreen;
  if Status <> 0 then begin
    WriteLn('Error initializing entry screen: ', Status);
    Halt(1);
  end;
  UR^.Name := Config^.GetPackName(PN);
  UR^.Key := Config^.GetPackChar(PN);
  UR^.Avail := Config^.GetPackAvail(PN);
  UR^.PackCmd := Config^.GetPackCmdLine(PN);
  UR^.UnPackCmd := Config^.GetUnPackCmdLine(PN);
  ES.Process;
  Config^.SetPackName(PN, UR^.Name);
  Config^.SetPackChar(PN, UR^.Key);
  Config^.SetPackAvail(PN, UR^.Avail);
  Config^.SetPackCmdLine(PN, UR^.PackCmd);
  Config^.SetUnPackCmdLine(PN, UR^.UnPackCmd);
  ES.Erase;
  HideMouse;
  ES.Done;
  Dispose(UR);
  End;


End.
