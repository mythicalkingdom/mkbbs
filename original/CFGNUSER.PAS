{$V-}

Unit CFGNUSER;

{$I OPDEFINE.INC}

Interface

Procedure DoCfgNUser;

Implementation

uses
  Dos,  OpInline,  OpString,  OpRoot,  OpCrt,  OpColor,  OpMouse,
  OpAbsFld,  OpCmd,  OpField,  OpFrame,  OpWindow,  OpSelect,
  OpEntry, CfgGlob, MKGlobT, MKString, MKCfgAbs;

const
  idAskHome              = 0;
  idAskData              = idAskHome + 1;
  idNewCredit            = idAskData + 1;
  idAskBirth             = idNewCredit + 1;
  idAskGender            = idAskBirth + 1;
  idAskHandle            = idAskGender + 1;
  idAskAddr              = idAskHandle + 1;
  idBitName              = idAskAddr + 1;
  idOneWord              = idBitName + 1;
  idReAsk                = idOneWord + 1;

const
  hiAskHome              = 1;
  hiAskData              = hiAskHome + 1;
  hiNewCredit            = hiAskData + 1;
  hiAskBirth             = hiNewCredit + 1;
  hiAskGender            = hiAskBirth + 1;
  hiAskHandle            = hiAskGender + 1;
  hiAskAddr              = hiAskHandle + 1;
  hiBitName              = hiAskAddr + 1;
  hiOneWord              = hiBitName + 1;
  hiReAsk                = hiOneWord + 1;

Type UserRecord = Record
  AskHome: Boolean;
  AskData: Boolean;
  NewCredit: Word;
  AskBirth: Boolean;
  AskGender: Boolean;
  AskHandle: Boolean;
  AskAddr: Boolean;
  BitName: Boolean;
  OneWord: Boolean;
  ReAsk: Boolean;
  End;


Var
  ES     : EntryScreen;
  Status : Word;
  UR: ^UserRecord;


{$F+}
procedure PreEdit(ESP : EntryScreenPtr);
  {-Called just before a field is edited}
begin
  with ESP^ do
    case GetCurrentID of
      idAskHome              : ;
      idAskData              : ;
      idNewCredit            : ;
      idAskBirth             : ;
      idAskGender            : ;
      idAskHandle            : ;
      idAskAddr              : ;
      idBitName              : ;
      idOneWord              : ;
      idReAsk                : ;
    end;
end;

procedure PostEdit(ESP : EntryScreenPtr);
  {-Called just after a field has been edited}
begin
  with ESP^ do
    case GetCurrentID of
      idAskHome              : ;
      idAskData              : ;
      idNewCredit            : ;
      idAskBirth             : ;
      idAskGender            : ;
      idAskHandle            : ;
      idAskAddr              : ;
      idBitName              : ;
      idOneWord              : ;
      idReAsk                : ;
    end;
end;

procedure IncChoice(var Value; ID : Word; Factor : Integer; var St : string);
  {-Increment a multiple choice field value and convert it to a string}
begin
end;

procedure ErrorHandler(UnitCode : Byte; var ErrCode : Word; Msg : string);
  {-Report errors}
begin
  RingBell;
end;

procedure DisplayHelp(UnitCode : Byte; IdPtr : Pointer; HelpIndex : Word);
  {-Display context sensitive help}
begin
end;
{$F-}

function InitEntryScreen : Word;
  {-Initialize entry screen generated by MAKESCRN}
const
  WinOptions = wBordered+wClear+wUserContents;
begin
  with ES do begin
    if not InitCustom(8, 7, 71, 18, EsColors, WinOptions) then begin
      InitEntryScreen := InitStatus;
      Exit;
    end;

    wFrame.SetFrameType(Frame1);
    wFrame.AddShadow(shBR, shSeeThru);
    wFrame.AddHeader('[ User Configuration ]', heTC);
    esFieldOptionsOn(efCursorToEnd+efClearFirstChar);
    SetWrapMode(WrapAtEdges);

    SetPreEditProc(PreEdit);
    SetPostEditProc(PostEdit);
    SetErrorProc(ErrorHandler);
    EntryCommands.SetHelpProc(DisplayHelp);

  {idAskHome:}
    esFieldOptionsOn(efClickExit);
    AddYesNoField(
      'Ask Home/Voice Phone:', 2, 3,
      'Y', 2, 25,
      hiAskHome, UR^.AskHome);
    esFieldOptionsOff(efClickExit);

  {idAskData:}
    esFieldOptionsOn(efClickExit);
    AddYesNoField(
      'Ask Data/Business Phone:', 2, 31,
      'Y', 2, 56,
      hiAskData, UR^.AskData);
    esFieldOptionsOff(efClickExit);

  {idNewCredit:}
    AddWordField(
      'Netmail Credit:', 4, 3,
      '99999', 4, 19,
      hiNewCredit, 0, 32767, UR^.NewCredit);

  {idAskBirth:}
    esFieldOptionsOn(efClickExit);
    AddYesNoField(
      'Ask BirthDate:', 4, 28,
      'Y', 4, 43,
      hiAskBirth, UR^.AskBirth);
    esFieldOptionsOff(efClickExit);

  {idAskGender:}
    esFieldOptionsOn(efClickExit);
    AddYesNoField(
      'Ask Gender:', 4, 49,
      'Y', 4, 61,
      hiAskGender, UR^.AskGender);
    esFieldOptionsOff(efClickExit);

  {idAskHandle:}
    esFieldOptionsOn(efClickExit);
    AddYesNoField(
      'Ask for Handle:', 6, 3,
      'Y', 6, 19,
      hiAskHandle, UR^.AskHandle);
    esFieldOptionsOff(efClickExit);

  {idAskAddr:}
    esFieldOptionsOn(efClickExit);
    AddYesNoField(
      'Ask for Address:', 6, 24,
      'Y', 6, 41,
      hiAskAddr, UR^.AskAddr);
    esFieldOptionsOff(efClickExit);


  {idBitName:}
    esFieldOptionsOn(efClickExit);
    AddYesNoField(
      'Force 7 bit Names:', 8, 3,
      'Y', 8, 22,
      hiBitName, UR^.BitName);
    esFieldOptionsOff(efClickExit);

  {idOneWord:}
    esFieldOptionsOn(efClickExit);
    AddYesNoField(
      'Allow One Word Names:', 8, 27,
      'Y', 8, 49,
      hiOneWord, UR^.OneWord);
    esFieldOptionsOff(efClickExit);

  {idReAsk:}
    esFieldOptionsOn(efClickExit);
    AddYesNoField(
      'Re-Ask Questions with Blanks:', 10, 3,
      'Y', 10, 33,
      hiReAsk, UR^.ReAsk);
    esFieldOptionsOff(efClickExit);

    InitEntryScreen := RawError;
  end;
end;


Procedure DoCfgNUser;
  Begin
  New(UR);
  UR^.AskHome := Config^.GetAskVoicePhone;
  UR^.AskData := Config^.GetAskDataPhone;
  UR^.AskBirth := Config^.GetAskBirthDate;
  UR^.AskGender := Config^.GetAskGender;
  UR^.AskHandle := Config^.GetAskHandle;
  UR^.AskAddr := Config^.GetAskAddr;
  UR^.BitName := Config^.GetSevenBitNames;
  UR^.OneWord := Config^.GetOneWordName;
  UR^.ReAsk := Config^.GetReAsk;
  UR^.NewCredit := Config^.GetNewUserNMCredit;
  if MouseInstalled then
    with EsColors do begin
      {activate mouse cursor}
      SoftMouseCursor($0000, (ColorMono(MouseColor, MouseMono) shl 8)+
                             Byte(MouseChar));
      ShowMouse;
      {enable mouse support}
      EntryCommands.cpOptionsOn(cpEnableMouse);
    end;
  Status := InitEntryScreen;
  if Status <> 0 then begin
    WriteLn('Error initializing entry screen: ', Status);
    Halt(1);
  end;
  ES.Process;
  ES.Erase;
  HideMouse;
  ES.Done;
  Config^.SetAskVoicePhone(UR^.AskHome);
  Config^.SetAskDataPhone(UR^.AskData);
  Config^.SetAskBirthDate(UR^.AskBirth);
  Config^.SetAskGender(UR^.AskGender);
  Config^.SetAskHandle(UR^.AskHandle);
  Config^.SetAskAddr(UR^.AskAddr);
  Config^.SetSevenBitNames(UR^.BitName);
  Config^.SetOneWordName(UR^.OneWord);
  Config^.SetReAsk(UR^.ReAsk);
  Config^.SetNewUserNMCredit(UR^.NewCredit);
  Dispose(UR);
  End;


End.
