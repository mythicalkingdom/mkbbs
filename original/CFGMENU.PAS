function InitMenu(var M : Menu) : Word;
  {-Initialize menu system generated by MAKEMENU}
  begin
  with M do
    begin
    if not InitCustom(2, 2, 79, 2, esColors,
                      wBordered+wClear+wUserContents+wCoversOnDemand,
                      Horizontal) then
      begin
      InitMenu := InitStatus;
      Exit;
      end;
    mnOptionsOn(mnAlphaMatch+mnSelectOnMatch+mnAllowPending+mnArrowSelect+
                mnAllHotSpots+mnAltMatch);
    mnOptionsOff(mnPopOnSelect+mnUseItemForTopic+mnSelectOnClick);
    wFrame.SetFrameType(Frame1);
    AddShadow(shBR, shSeeThru);
    AddItemHelp('General', 3, 1, miGeneral0,
                ' General Configuration');
      AddFramedSubMenu(5, 4, 15, 15, Vertical, Frame1);
      AddShadow(shBR, shSeeThru);
      AddItemHelp('General', 1, 1, miGeneral1,
                  ' General Set-up');
      AddItemHelp('Bbs Paths', 2, 1, miBbs2,
                  ' Set-up Paths and Directories');
      AddItemHelp('Language', 3, 1, miLanguage3,
                  ' Set-up Langauages');
      AddItemHelp('New Users', 4, 1, miNew4,
                  ' Set-up new user defaults');
      AddItemHelp('Security', 5, 1, miSecurity5,
                  ' Set-up Security options');
        AddFramedSubMenu(7,10,20,17, Vertical, Frame1);
        AddShadow(shBR, shSeeThru);
        AddItemHelp('Options',1,1,miSecOpt21,' Security Options');
        AddItemHelp('New User',2,1,miSecNew22,' New User Security');
        AddItemHelp('Attach',3,1,miSecFA23,' File Attach Security');
        AddItemHelp('Request',4,1,miSecFR24,' File Request Security');
        AddItemHelp('Crash NM',5,1,miSecCrash25,' Crash Netmail Security');
        AddItemHelp('Force Crash NM', 6, 1, miSecForce32,
          ' Security to Force Crash Netmail');
        AddItemHelp('Delete',7,1,miSecMDel26,
          ' Security to Delete Msgs To/From Caller');
        AddItemHelp('UnReceive',8,1,miSecUnRcv27,
          ' Security to UnReceive a Message');
        ItemsDone;
      AddItemHelp('Addresses', 6, 1, miAddresses6,
                  ' Set-up System Addresses');
      AddItemHelp('Paging', 7, 1, miPaging7,
                  ' Set-up Paging options');
      AddItemHelp('Modem Resp', 8, 1, miResponse33,
                  ' Modem connect repsonse strings');
      AddItemHelp('ErrorLevels', 9, 1, miErrorLevel34,
                  ' ErrorLevels for Baud rates');
      AddItemHelp('Doors', 10, 1, miDoor44,
                  ' Doors available from Log-on');
      AddItemHelp('Packers', 11, 1, miPack45,
                  ' Archive compression setup');
      AddItemHelp('Offline Type', 12, 1, miOffType46,
                  ' Offline Mail Packet Types');
      ItemsDone;
    AddItemHelp('Messages', 17, 1, miMessages8,
                ' Message Configuration');
      AddFramedSubMenu(19, 4, 32, 8, Vertical, Frame1);
      AddShadow(shBR, shSeeThru);
      AddItemHelp('Areas', 1, 1, miAreas9,
                  ' Message area configuration');
      AddItemHelp('Msg Options',2,1,miMsgOpt30,
                  ' Message Configuration Options');
      AddItemHelp('Origin Lines', 3, 1, miOrg31,
                  ' Set Origin Line Text');
      AddItemHelp('Fast Options', 4, 1, miFast10,
                  ' Fast Message Area Configuration Options');
        AddFramedSubMenu(21, 9, 44, 22, Vertical, Frame1);
        AddShadow(shBR, shSeeThru);
        AddItemHelp('Combined', 1, 1, miCombined11,
          ' Fast Allow Combined Access');
        AddItemHelp('Ansi', 2, 1, miAnsi12,
          ' Fast Allow Ansi');
        AddItemHelp('Hi-Bit Chars', 3, 1, miHiBit13,
          ' Fast Allow Hi-Bit Characters');
        AddItemHelp('Taglines', 4, 1, miTaglines14,
          ' Fast Allow Offline Reader Taglines');
        AddItemHelp('Fido Info', 5, 1, miFido15,
          ' Fast Add Fido Info');
        AddItemHelp('Reader Tearlines', 6, 1,  miFastTear35,
          ' Fast Allow Offline Reader Tearlines');
        AddItemHelp('Offline', 7, 1,  miFastOffline36,
          ' Fast Allow Offline Access');
        AddItemHelp('Force Offline', 8, 1,  miFastForceOff37,
          ' Fast Force for Offline');
        AddItemHelp('Default Combined', 9, 1, miFastDefComb38,
          ' Fast Default Combined');
        AddItemHelp('Reader Origin', 10, 1, miFastReadOrig39,
          ' Fast Use Offline Reader Origin');
        AddItemHelp('Import Path', 11, 1, miFastImpPath40,
          ' Fast Import Path Line');
        AddItemHelp('Hide Path', 12, 1, miFastHidePath41,
          ' Fast Hide Imported Path Line');
        AddItemHelp('Import Seen-By', 13, 1, miFastImpSeen42,
          ' Fast Import Seen-By');
        AddItemHelp('Hide Seen-By', 14, 1, miFastHideSeen43,
          ' Fast Hide Imported Seen-By');
        ItemsDone;
      AddItemHelp('Offline', 5, 1, miOffCfg47,
                  'Offline mail options/settings');
      ItemsDone;
    AddItemHelp('Files', 32, 1, miFiles16,
                ' Files Configuration');
      AddFramedSubMenu(34, 4, 47, 5, Vertical, Frame1);
      AddShadow(shBR, shSeeThru);
      AddItemHelp('Areas', 1, 1, miFileArea28,
