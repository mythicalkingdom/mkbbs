      AddItemHelp('Options', 2, 1, miEchoOpt20,
                  ' EchoMail Options');
      ItemsDone;
    AddItemHelp('Quit', 71, 1, miQuit18,
                ' Quit and Save Changes');
    ItemsDone;

    SetErrorProc(ErrorHandler);
    MenuCommands.SetHelpProc(DisplayHelp);
    SetCustomStringProc(CustomizeItemString);

    InitMenu := RawError;
    end;
  end;

function InitHelpLine(var H : RawWindow) : Word;
  {-Initialize window for the help line}
  var
    Row : Byte;

  begin
  Row := 25;
  if not H.InitCustom(1, Row, ScreenWidth, Row,
                      esColors, wClear) then begin
    InitHelpLine := InitStatus;
    Exit;
  end;
  H.SetTextAttr(YellowOnBlue, LtGrayOnBlack);
  InitHelpLine := 0;
  end;


var
  Status : Word;
  M: Menu;      {menu system}
  H: RawWindow; {item help window}
  B: RawWindow; {Banner window}


procedure UpdateHelpLine(CurrentItem : MenuItemNodePtr; MPtr : MenuPtr);
  {-Update HelpLine for each menu item}
  var
    S : String;
  begin
  if CurrentItem = nil then
    S := ''
  else
    S := CurrentItem^.HelpString;
  H.wFastText(Pad(S, H.Width), 1, 1);
  end;


Procedure DoMenu;
  Var
    MenuDone: Boolean;
    Sec: SecType;

  Begin
  MenuDone := False;
  TextChar := #176;
  TextAttr := LtGrayOnBlack;
  ClrScr;
  B.InitCustom(20,18,60,21,esColors, wClear + wBordered);
  B.wFrame.SetFrameType(Frame1);
  B.wFrame.AddShadow(shBR, shSeeThru);
  B.Draw;
  WriteLn;
  WriteLn('          MK Bbs Configuration');
  WriteLn('       Copyright 1992 By Mark May');
  Status := InitMenu(M);
  if Status <> 0 then begin
    WriteLn('Error initializing menu: ', Status);
    Halt(1);
  end;
  Status := InitHelpLine(H);
  if Status <> 0 then begin
    WriteLn('Error initializing help line: ', Status);
    Halt(1);
  end;
  M.SetCurrentItemProc(UpdateHelpLine);
  if MouseInstalled then
    with esColors do begin
      {activate mouse cursor}
      SoftMouseCursor($0000, (ColorMono(MouseColor, MouseMono) shl 8)+
                             Byte(MouseChar));
      ShowMouse;
      {enable mouse support}
      MenuCommands.cpOptionsOn(cpEnableMouse);
    end;
  H.Draw;
  M.Draw;
  While Not MenuDone Do
    Begin
    M.Process;
    Case M.GetLastCommand of
      ccSelect:
        Begin
        case M.MenuChoice of
          miGeneral1: DoCfgGen;
          miBbs2: DoCfgPath;
          miLanguage3: DoCfgPLan;
          miNew4: DoCfgNUser;
          miAddresses6: DoCfgPAddr;
          miPaging7: DoCfgPage;
          miAreas9: DoCfgMArea;
          miCombined11: DoFastPick(1);
          miAnsi12: DoFastPick(2);
          miHiBit13: DoFastPick(3);
          miTaglines14: DoFastPick(4);
          miFido15: DoFastPick(5);
          miFiles16:;
          miEvents17: DoCfgEvent;
          miQuit18: MenuDone := True;
          miEchoSys19: DoCfgPSys;
          miEchoOpt20: DoCfgEOpt;
          miSecOpt21: DoCfgSec;
          miSecNew22: Begin
                      Config^.GetNewUserSec(Sec);
                      EnterSec(Sec, '[ New User ]');
                      Config^.SetNewUserSec(Sec);
                      End;
          miSecFA23:  Begin
                      Config^.GetAttachSec(Sec);
                      EnterSec(Sec, '[ File Attach ]');
                      Config^.SetAttachSec(Sec);
                      End;
          miSecFR24:  Begin
                      Config^.GetRequestSec(Sec);
                      EnterSec(Sec, '[ File Request ]');
                      Config^.SetRequestSec(Sec);
                      End;
          miSecCrash25: Begin
                      Config^.GetCrashNMSec(Sec);
                      EnterSec(Sec, '[ Crash NM ]');
                      Config^.SetCrashNMSec(Sec);
                      End;
          miSecMDel26: Begin
                      Config^.GetDeleteSec(Sec);
                      EnterSec(Sec, '[ Msg Delete ]');
                      Config^.SetDeleteSec(Sec);
                      End;
          miSecUnRcv27: Begin
                      Config^.GetUnRcvSec(Sec);
                      EnterSec(Sec, '[ Msg UnReceive ]');
                      Config^.SetUnRcvSec(Sec);
                      End;
          miSecForce32 : Begin
                      Config^.GetForceCrashNMSec(Sec);
                      EnterSec(Sec, '[ Force Crash NM ]');
                      Config^.SetForceCrashNMSec(Sec);
                      End;
          miFileArea28: DoCfgFArea;
          miFileOpt29: DoCfgXfer;
          miMsgOpt30: ;
          miOrg31: DoCfgOrig;
          miResponse33: DoCfgResp;
          miErrorLevel34: DoCfgEL;
          miFastTear35: DoFastPick(6);
          miFastOffline36: DoFastPick(7);
          miFastForceOff37: DoFastPick(8);
          miFastDefComb38: DoFastPick(9);
          miFastReadOrig39: DoFastPick(10);
          miFastImpPath40: DoFastPick(11);
          miFastHidePath41:DoFastPick(12);
          miFastImpSeen42: DoFastPick(13);
          miFastHideSeen43: DoFastPick(14);
          miDoor44: DoPickDoor;
          miPack45: DoCfgPPack;
          miOffType46: DoCfgOffType;
          miOffCfg47: EditOffCfgP;
          End;
        End;
      ccQuit : MenuDone := True;
      ccError : MenuDone := True;
      End;
    End;
  M.Erase;
  H.Erase;
  B.Erase;
  HideMouse;
  B.Done;
  H.Done;
  M.Done;
  End;


End.
