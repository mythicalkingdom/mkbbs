{$V-}

Unit CFGDOOR;

{$I OPDEFINE.INC}


Interface

Procedure DoPickDoor;
Procedure DoCfgDoor(DN: Word);

Implementation

Uses
  Dos,  OpInline,  OpString,  OpRoot,  OpCrt,  OpColor,  OpMouse,
  OpAbsFld,  OpCmd,  OpField,  OpFrame,  OpWindow,  OpSelect,
  OpEntry, OpPick, CfgGlob, MKGlobT, MKCfgAbs, MKString, CfgSec2;

const
  idData                 = 0;
  idSec                  = idData + 1;

{Help index constants}
const
  hiData                 = 1;
  hiSec                  = hiData + 1;

Type UserRecord = Record
  Data: string[79];
  Sec: SecType;
  End;


Var
  ES: EntryScreen;
  DoorPick: PickList;
  UR: ^UserRecord;
  Status: Word;

{$F+}
procedure PreEdit(ESP : EntryScreenPtr);
  {-Called just before a field is edited}
begin
  with ESP^ do
    case GetCurrentID of
      idData                 : ;
      idSec: GetSecurity(UR^.Sec, ESP, idSec, '[ Door Security ]');
    end;
end;

procedure PostEdit(ESP : EntryScreenPtr);
  {-Called just after a field has been edited}
begin
  with ESP^ do
    case GetCurrentID of
      idData                 : ;
      idSec                  : ;
    end;
end;

procedure IncChoice(var Value; ID : Word; Factor : Integer; var St : string);
  {-Increment a multiple choice field value and convert it to a string}
begin
end;

procedure ErrorHandler(UnitCode : Byte; var ErrCode : Word; Msg : string);
  {-Report errors}
begin
  RingBell;
end;

procedure DisplayHelp(UnitCode : Byte; IdPtr : Pointer; HelpIndex : Word);
  {-Display context sensitive help}
begin
end;
{$F-}

function InitEntryScreen(DN: Word): Word;
  {-Initialize entry screen generated by MAKESCRN}
const
  WinOptions = wBordered+wClear+wUserContents;
begin
  with ES do begin
    if not InitCustom(5, 15, 75, 19, EsColors, WinOptions) then begin
      InitEntryScreen := InitStatus;
      Exit;
    end;

    wFrame.SetFrameType(Frame1);
    wFrame.AddShadow(shBR, shSeeThru);
    wFrame.AddHeader('[ Door Config #' + Long2Str(DN) + ' ]', heTC);
    esFieldOptionsOn(efCursorToEnd+efClearFirstChar);
    SetWrapMode(WrapAtEdges);

    SetPreEditProc(PreEdit);
    SetPostEditProc(PostEdit);
    SetErrorProc(ErrorHandler);
    EntryCommands.SetHelpProc(DisplayHelp);

  {idData:}
    AddStringField(
      'Door Data:', 2, 3,
      CharStr('X', 79), 2, 14, 50,
      hiData, UR^.Data);

  {idSec:}
    AddWordField(
      'Security:', 4, 3,
      '99999', 4, 13,
      hiSec, 0, 65535, UR^.Sec.Level);

    InitEntryScreen := RawError;
  end;
end;




{$F+}
Procedure DoorStr(Item: Word; Mode: PkMode; Var IType: PkItemType; Var
  IString: String; PickPtr: PickListPtr);

  Begin
  IString := PadLeft(Long2Str(Item),' ',2) + ' ' + Copy(Config^.GetDoorData(Item), 1, 55);
  End;
{$F-}



Procedure DoPickDoor;
  Var
    EdMore: Boolean;
    CfgDoorNo: Word;

  Begin
  EdMore := True;
  If Not doorpick.InitCustom(3,8,76,22,ESColors,
    wBordered+wClear+wUserContents,
    60, 10, DoorStr,PickVertical, SingleChoice) Then
    Halt;
  doorpick.wFrame.SetFrameType(Frame1);
  doorpick.wFrame.AddShadow(shBR, shSeeThru);
  doorpick.wFrame.AddHeaderColor('[ Log-On Doors ]', heTC, WhiteOnBlue, BlackOnLtGray);
  doorpick.wFrame.AddCustomScrollBar(frRR, 1, MaxLongInt, 1, 1, '²', '°', EsColors);
  While EdMore Do
    Begin
    doorpick.Process;
    doorpick.Erase;
    If doorpick.GetLastCommand = ccSelect Then
      Begin
      CfgDoorNo := doorpick.GetLastChoice;
      DoCfgDoor(CfgDoorNo);
      End
    Else
      EdMore := False;
    End;
  doorpick.Done;
  End;


Procedure DoCfgDoor(DN: Word);
  Begin
  New(UR);
  Config^.GetDoorSec(DN, UR^.Sec);
  UR^.Data := Config^.GetDoorData(DN);
  if MouseInstalled then
    with EsColors do begin
      {activate mouse cursor}
      SoftMouseCursor($0000, (ColorMono(MouseColor, MouseMono) shl 8)+
                             Byte(MouseChar));
      ShowMouse;
      {enable mouse support}
      EntryCommands.cpOptionsOn(cpEnableMouse);
    end;
  Status := InitEntryScreen(DN);
  if Status <> 0 then begin
    WriteLn('Error initializing entry screen: ', Status);
    Halt(1);
  End;
  ES.Process;
  ES.Erase;
  HideMouse;
  ES.Done;
  Config^.SetDoorSec(DN, UR^.Sec);
  Config^.SetDoorData(DN, UR^.Data);
  Dispose(UR);
  End;


End.
