{$V-}

Unit CFGEOPT;

{$I OPDEFINE.INC}

Interface

Procedure DoCfgEOpt;

Implementation

uses
  Dos,  OpInline,  OpString,  OpRoot,  OpCrt,  OpColor,
  OpMouse,  OpAbsFld,  OpCmd,  OpField,  OpFrame,  OpWindow,
  OpSelect,  OpEntry, MKCfgAbs, CfgGlob, MKString;

{Entry field constants}
const
  idInBound              = 0;
  idOutBound             = idInBound + 1;
  idMaxPkt               = idOutBound + 1;

{Help index constants}
const
  hiInBound              = 1;
  hiOutBound             = hiInBound + 1;
  hiMaxPkt               = hiOutBound + 1;

Type UserRecord = Record
 InBound              : string[50];
 OutBound             : string[50];
 MaxPkt               : LongInt;
 End;


Var
  ES : EntryScreen;
  UR : ^UserRecord;
  Status : Word;

{$F+}
procedure PreEdit(ESP : EntryScreenPtr);
  {-Called just before a field is edited}
begin
  with ESP^ do
    case GetCurrentID of
      idInBound              : ;
      idOutBound             : ;
      idMaxPkt               : ;
    end;
end;

procedure PostEdit(ESP : EntryScreenPtr);
  {-Called just after a field has been edited}
begin
  with ESP^ do
    case GetCurrentID of
      idInBound: Begin
        AddBackSlash(UR^.InBound);
        ESP^.DrawField(idInBound);
        End;
      idOutBound: Begin
        AddBackSlash(UR^.OutBound);
        ESP^.DrawField(idOutBound);
        End;
      idMaxPkt               : ;
    end;
end;

procedure IncChoice(var Value; ID : Word; Factor : Integer; var St : string);
  {-Increment a multiple choice field value and convert it to a string}
begin
end;

procedure ErrorHandler(UnitCode : Byte; var ErrCode : Word; Msg : string);
  {-Report errors}
begin
  RingBell;
end;

procedure DisplayHelp(UnitCode : Byte; IdPtr : Pointer; HelpIndex : Word);
  {-Display context sensitive help}
begin
end;
{$F-}

function InitEntryScreen : Word;
  {-Initialize entry screen generated by MAKESCRN}
const
  WinOptions = wBordered+wClear+wUserContents;
begin
  with ES do begin
    if not InitCustom(5, 9, 74, 15, EsColors, WinOptions) then begin
      InitEntryScreen := InitStatus;
      Exit;
    end;

    wFrame.SetFrameType(Frame1);
    wFrame.AddShadow(shBR, shSeeThru);
    wFrame.AddHeader('[ EchoMail Options ]', heTC);
    esFieldOptionsOn(efCursorToEnd+efClearFirstChar);
    SetWrapMode(WrapAtEdges);

    SetPreEditProc(PreEdit);
    SetPostEditProc(PostEdit);
    SetErrorProc(ErrorHandler);
    EntryCommands.SetHelpProc(DisplayHelp);

  {idInBound:}
    AddStringField(
      'InBound Path:', 2, 3,
      CharStr('X', 50), 2, 17, 50,
      hiInBound, UR^.InBound);

  {idOutBound:}
    AddStringField(
      'OutBound Path:', 4, 3,
      CharStr('X', 50), 4, 18, 50,
      hiOutBound, UR^.OutBound);

  {idMaxPkt:}
    AddLongField(
      'Maximum *.PKT File Size:', 6, 3,
      '999999', 6, 28,
      hiMaxPkt, 0, 999999, UR^.MaxPkt);

    InitEntryScreen := RawError;
  end;
end;



Procedure DoCfgEOpt;
  Begin
  New(UR);
  UR^.InBound := Config^.GetEchoInPath;
  UR^.OutBound := Config^.GetEchoOutPath;
  UR^.MaxPkt := Config^.GetEchoMaxPkt;
  if MouseInstalled then
    with EsColors do begin
      {activate mouse cursor}
      SoftMouseCursor($0000, (ColorMono(MouseColor, MouseMono) shl 8)+
                             Byte(MouseChar));
      ShowMouse;
      {enable mouse support}
      EntryCommands.cpOptionsOn(cpEnableMouse);
    end;
  Status := InitEntryScreen;
  if Status <> 0 then begin
    WriteLn('Error initializing entry screen: ', Status);
    Halt(1);
  end;
  ES.Process;
  ES.Erase;
  HideMouse;
  ES.Done;
  Config^.SetEchoInPath(UR^.InBound);
  Config^.SetEchoOutPath(UR^.OutBound);
  Config^.SetEchoMaxPkt(UR^.MaxPkt);
  Dispose(UR);
  End;


End.
