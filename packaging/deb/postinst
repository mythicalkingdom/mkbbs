#!/bin/sh
# mkbbs: the user of the listener, the first configuration file, the log directory.  The service is not started or enabled: it needs a BBS and a
# configuration first.
set -e

case "$1" in
configure)
    if ! getent passwd mkbbs >/dev/null 2>&1; then
        if command -v systemd-sysusers >/dev/null 2>&1; then
            systemd-sysusers /usr/lib/sysusers.d/mkbbs.conf || true
        fi
        if ! getent passwd mkbbs >/dev/null 2>&1; then
            adduser --system --group --no-create-home --home /nonexistent --gecos "MK BBS" mkbbs >/dev/null
        fi
    fi
    ex=/usr/share/doc/mkbbs/examples/mklisten.example.json
    if [ ! -e /etc/mkbbs/mklisten.json ] && [ -f "$ex" ]; then
        install -d -m 755 /etc/mkbbs
        sed -e 's|"/usr/local/bin/mk"|"/usr/bin/mk"|' \
            -e '/"logfile"/a\  "rundir": "/run/mkbbs",' \
            "$ex" > /etc/mkbbs/mklisten.json
        chown root:mkbbs /etc/mkbbs/mklisten.json
        chmod 640 /etc/mkbbs/mklisten.json
        echo "mkbbs: created /etc/mkbbs/mklisten.json from the example: edit the paths and the sysop password,"
        echo "       then   systemctl enable --now mklisten"
    fi
    install -d -m 755 -o mkbbs -g mkbbs /var/log/mkbbs
    if [ -d /run/systemd/system ]; then
        systemctl daemon-reload >/dev/null 2>&1 || true
    fi
    ;;
esac

exit 0
